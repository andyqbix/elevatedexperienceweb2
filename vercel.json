{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "trailingSlash": true,
  "redirects": [
    { "source": "/hx/", "destination": "https://hive.elevatedexperience.vip/", "permanent": true },
    { "source": "/resources/hive-experience/", "destination": "/hx-hive-experience/", "statusCode": 301 },
    { "source": "/corporate-event-from-burnout-to-brilliance/", "destination": "/experiences/", "permanent": true },
    { "source": "/partners/", "destination": "/coachsulting/", "permanent": true },
    { "source": "/2026/11/09/hx-free-whats-the-catch-there-isnt-one/", "destination": "/resources/hx-free-whats-the-catch-there-isnt-one/", "permanent": true },
    { "source": "/2026/07/14/social-media-is-broken-lets-fix-it/", "destination": "/resources/social-media-is-broken-let-s-fix-it/", "permanent": true },
    { "source": "/2026/06/03/how-disconnected-dx-ex-and-cx-affects-business-growth/", "destination": "/resources/how-disconnected-dx-ex-and-cx-affects-business-growth/", "permanent": true },
    { "source": "/2026/05/26/the-great-divergence-how-we-missed-the-ultimate-experience-and-how-to-reclaim-it/", "destination": "/resources/the-great-divergence-how-we-missed-the-ultimate-experience-and-how-to-reclaim-it/", "permanent": true },
    { "source": "/2026/:path*", "destination": "/resources/", "permanent": false }
  ],
  "headers": [
    { "source": "/video/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }] },
    { "source": "/_astro/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
    ] }
  ]
}
