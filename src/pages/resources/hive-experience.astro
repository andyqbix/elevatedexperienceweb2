---
// HX (The Hive eXperience) page: /resources/hive-experience/
// Uses the HX Belonging Knot palette, scoped to this page as --hx- custom properties so it does not leak.
// Lora (headings) is loaded on this page only.
import '@fontsource/lora/400.css';
import '@fontsource/lora/500.css';
import { Picture, getImage } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import { hx as c } from '@/content/hx';
import { links, site } from '@/data/site';
import heroDesktop from '@/assets/hx/hx-hero-belonging-knot.png';
import heroMobile from '@/assets/hx/hx-hero-mobile.png';
import showcase from '@/assets/hx/hx-app-showcase.png';
import knotIvory from '@/assets/hx/hx-belonging-knot-ivory.png';
import ctaBand from '@/assets/hx/hx-cta-band.png';
import cornerTr from '@/assets/hx/hx-open-knot-corner-tr.png';
import cornerBl from '@/assets/hx/hx-open-knot-corner-bl.png';
import ogImage from '@/assets/hx/hx-og-share-1200x630.png';
import home from '@/assets/hx/hx-feature-home.png';
import cafe from '@/assets/hx/hx-feature-cafe.png';
import community from '@/assets/hx/hx-feature-community.png';
import events from '@/assets/hx/hx-feature-events.png';
import school from '@/assets/hx/hx-feature-school.png';
import businesses from '@/assets/hx/hx-feature-businesses.png';
import chat from '@/assets/hx/hx-feature-chat.png';

const shots = { home, cafe, community, events, school, businesses, chat };
const abs = (p: string) => new URL(p, site.url).href;

// Hero art direction: square artwork on phones, wide artwork from tablet up. WebP with PNG fallback.
const mq = '(min-width: 48rem)';
const heroWide = await getImage({ src: heroDesktop, format: 'webp', widths: [1280, 1920, 2400] });
const heroWidePng = await getImage({ src: heroDesktop, format: 'png', width: 1600 });
const heroSq = await getImage({ src: heroMobile, format: 'webp', widths: [600, 900, 1200] });
const heroSqPng = await getImage({ src: heroMobile, format: 'png', width: 900 });
const og = await getImage({ src: ogImage, format: 'png', width: 1200, height: 630 });

const pic = { formats: ['webp'] as const, fallbackFormat: 'png' as const, loading: 'lazy' as const, decoding: 'async' as const };

// The walkthrough uses the site's existing booking link.
const ext = { target: '_blank', rel: 'noopener noreferrer' };
const enterpriseMail = 'mailto:hx@elevatedexperience.vip?subject=HX%20Enterprise';

const schema = [
  {
    '@type': 'SoftwareApplication', '@id': abs(links.hxPage) + '#software', name: 'HX (The Hive eXperience)',
    applicationCategory: 'SocialNetworkingApplication', operatingSystem: 'Web browser', url: links.hx,
    description: c.meta.description, image: abs(og.src),
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'GBP' },
    publisher: { '@id': site.url + '/#organization' },
  },
  {
    '@type': 'FAQPage', '@id': abs(links.hxPage) + '#faq',
    mainEntity: c.faq.items.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---
<Base
  title={c.meta.title}
  description={c.meta.description}
  breadcrumb="HX | Hive eXperience"
  parent={{ name: 'Resources', href: links.resources }}
  shareImage={{ src: abs(og.src), alt: c.hero.alt }}
  schema={schema}
>
  <div class="hx">
    <!-- 1 | HERO -->
    <section class="hero dark">
      <picture class="hero-art">
        <source media={mq} type="image/webp" srcset={heroWide.srcSet.attribute} sizes="100vw" width={2400} height={1350} />
        <source media={mq} type="image/png" srcset={heroWidePng.src} width={2400} height={1350} />
        <source type="image/webp" srcset={heroSq.srcSet.attribute} sizes="(min-width: 30rem) 26rem, 92vw" width={1200} height={1200} />
        <img src={heroSqPng.src} alt={c.hero.alt} width={1200} height={1200} loading="eager" fetchpriority="high" decoding="async" />
      </picture>
      <div class="wrap hero-inner">
        <p class="eyebrow-hx">{c.hero.eyebrow}</p>
        <h1 class="hero-title">{c.hero.heading}</h1>
        <p class="hero-tagline">{c.hero.tagline}</p>
        <p class="hero-intro">{c.hero.intro}</p>
        <div class="actions">
          <a class="btn-hx" href={links.hx} {...ext}>{c.hero.primary}</a>
          <a class="btn-hx btn-hx-ghost" href="#inside-every-hive">{c.hero.secondary}</a>
        </div>
        <p class="trust">{c.hero.trust}</p>
      </div>
    </section>

    <!-- 2 | THE HX BELONGING KNOT -->
    <section class="sec ivory has-corner">
      <Picture src={cornerTr} alt="" widths={[450, 900]} sizes="22rem" class="corner corner-tr" {...pic} />
      <div class="wrap two-col">
        <div class="reveal">
          <p class="eyebrow-hx">{c.knot.eyebrow}</p>
          <h2 class="h2">{c.knot.heading}</h2>
          <p class="lead">{c.knot.body}</p>
        </div>
        <dl class="terms reveal">
          {c.knot.terms.map((t) => (
            <div class="term"><dt>{t.term}</dt><dd>{t.text}</dd></div>
          ))}
        </dl>
      </div>
    </section>

    <!-- 3 | BELONG. CONTRIBUTE. PROSPER. -->
    <section class="sec ivory sec-join" aria-labelledby="hx-pillars">
      <div class="wrap">
        <h2 class="sr-only" id="hx-pillars">{c.pillars.heading}</h2>
        <div class="pillars">
          {c.pillars.cards.map((p, i) => (
            <article class:list={['pillar reveal', i === 2 && 'pillar-dark']} style={`--d:${i * 90}ms`}>
              <p class="eyebrow-hx">{p.label}</p>
              <h3 class="h3">{p.heading}</h3>
              <p>{p.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- 4 | INSIDE EVERY HIVE -->
    <section class="sec dark" id="inside-every-hive">
      <div class="wrap">
        <div class="head-hx reveal">
          <p class="eyebrow-hx">{c.inside.eyebrow}</p>
          <h2 class="h2">{c.inside.heading}</h2>
          <p class="lead">{c.inside.intro}</p>
        </div>
        <div class="showcase reveal">
          <Picture src={showcase} alt={c.inside.alt} widths={[800, 1280, 1800, 2400]} sizes="(min-width: 82rem) 75rem, 92vw" {...pic} />
        </div>
        <ul class="spaces">
          {c.inside.spaces.map((s, i) => (
            <li class="space reveal" style={`--d:${(i % 4) * 80}ms`}>
              <svg class="hex" viewBox="0 0 24 24" aria-hidden="true"><polygon points="12 2 20.66 7 20.66 17 12 22 3.34 17 3.34 7" /></svg>
              <h3 class="h4">{s.name}</h3>
              <p>{s.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 5 | FEATURE ROWS -->
    <section class="sec ivory" aria-label="HX features">
      <div class="wrap rows">
        {c.features.map((f, i) => (
          <div class:list={['row', i % 2 === 1 && 'row-flip']}>
            <div class="row-media reveal">
              <Picture src={shots[f.img as keyof typeof shots]} alt={f.alt} widths={[640, 960, 1280, 1600]} sizes="(min-width: 64rem) 46vw, 92vw" {...pic} />
            </div>
            <div class="row-text reveal" style="--d:90ms">
              <p class="eyebrow-hx">{f.eyebrow}</p>
              <h2 class="h3">{f.heading}</h2>
              <p>{f.body}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 6 | WHAT THE KNOT MEANS -->
    <section class="sec ivory sec-rule has-corner">
      <Picture src={cornerBl} alt="" widths={[450, 900]} sizes="22rem" class="corner corner-bl" {...pic} />
      <div class="wrap meaning">
        <div class="meaning-art reveal">
          <Picture src={knotIvory} alt={c.meaning.alt} widths={[600, 900, 1400]} sizes="(min-width: 64rem) 40vw, 92vw" {...pic} />
        </div>
        <div class="reveal" style="--d:90ms">
          <p class="eyebrow-hx">{c.meaning.eyebrow}</p>
          <h2 class="h2 h2-sm">{c.meaning.heading}</h2>
          <dl class="points">
            {c.meaning.points.map((p) => <div class="point"><dt>{p.term}</dt><dd>{p.text}</dd></div>)}
          </dl>
          <p class="closing">{c.meaning.closing}</p>
        </div>
      </div>
    </section>

    <!-- 7 | FREE TO START -->
    <section class="sec dark">
      <div class="wrap two-col">
        <div class="reveal">
          <p class="eyebrow-hx">{c.free.eyebrow}</p>
          <h2 class="h2">{c.free.heading}</h2>
          <p class="lead">{c.free.body}</p>
          <p class="mt-btn"><a class="btn-hx" href={links.hx} {...ext}>{c.free.cta}</a></p>
        </div>
        <ul class="promises reveal" style="--d:90ms">
          {c.free.points.map((p) => <li><strong>{p.lead}</strong> {p.text}</li>)}
        </ul>
      </div>
    </section>

    <!-- 8 | HOW TO GET STARTED -->
    <section class="sec ivory">
      <div class="wrap">
        <h2 class="h2 reveal">{c.start.heading}</h2>
        <ol class="steps">
          {c.start.steps.map((s, i) => (
            <li class="step reveal" style={`--d:${i * 90}ms`}>
              <span class="step-n" aria-hidden="true">{i + 1}</span>
              <p><strong>{s.lead}</strong> {s.text}</p>
            </li>
          ))}
        </ol>
        <p class="mt-btn reveal"><a class="btn-hx" href={links.hx} {...ext}>{c.start.cta}</a></p>
      </div>
    </section>

    <!-- 9 | HX ENTERPRISE -->
    <section class="sec-tight sand">
      <div class="wrap enterprise reveal">
        <div>
          <p class="eyebrow-hx">{c.enterprise.eyebrow}</p>
          <h2 class="h2">{c.enterprise.heading}</h2>
          <p class="lead">{c.enterprise.body}</p>
        </div>
        <p><a class="btn-hx btn-hx-ghost" href={enterpriseMail}>{c.enterprise.cta}</a></p>
      </div>
    </section>

    <!-- 10 | FAQ -->
    <section class="sec ivory" id="faq">
      <div class="wrap faq-wrap">
        <h2 class="h2 reveal">{c.faq.heading}</h2>
        <div class="faq" data-faq>
          {c.faq.items.map((f, i) => (
            <div class="faq-item">
              <h3 class="faq-q">
                <button type="button" id={`faq-btn-${i}`} aria-expanded="true" aria-controls={`faq-panel-${i}`} data-faq-btn>
                  <span>{f.q}</span>
                  <span class="faq-icon" aria-hidden="true"></span>
                </button>
              </h3>
              <div class="faq-a" id={`faq-panel-${i}`} role="region" aria-labelledby={`faq-btn-${i}`}><p>{f.a}</p></div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 11 | FINAL CTA BAND -->
    <section class="cta-band">
      <Picture src={ctaBand} alt="" widths={[1200, 1800, 2400]} sizes="100vw" class="cta-bg" {...pic} />
      <div class="wrap cta-inner reveal">
        <h2 class="h2 cta-title">{c.cta.heading}</h2>
        <p class="lead">{c.cta.body}</p>
        <div class="actions actions-center">
          <a class="btn-hx" href={links.bookCall} {...ext}>{c.cta.primary}</a>
          <a class="btn-hx btn-hx-ghost" href={links.hx} {...ext}>{c.cta.secondary}</a>
        </div>
        <p class="signoff">{c.cta.signoff}</p>
      </div>
    </section>
  </div>
</Base>

<style>
  .hx {
    /* HX Belonging Knot palette: core */
    --hx-graphite: #2e2e2e;
    --hx-ivory: #f8f4ec;
    --hx-copper: #b96e50;
    /* Supporting */
    --hx-bronze: #9a4e25;
    --hx-copper-light: #d3854f;
    --hx-sand: #eeb37c;
    --hx-peach: #f6cb9d;
    --hx-taupe: #9e9388;
    --hx-umber: #4e3f36;
    --hx-line: rgb(158 147 136 / .3);
    --hx-radius: 4px;
    --hx-serif: "Lora", Georgia, "Times New Roman", serif;
    font-family: var(--font-sans);
    color: var(--hx-graphite);
  }
  .hx :focus-visible { outline: 2px solid var(--hx-copper-light); outline-offset: 3px; }
  .ivory :focus-visible, .sand :focus-visible { outline-color: var(--hx-bronze); }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  /* Surfaces */
  .dark { background: var(--hx-graphite); color: var(--hx-ivory); }
  .ivory { background: var(--hx-ivory); color: var(--hx-graphite); }
  .sand { background: var(--hx-sand); color: var(--hx-graphite); }
  .sec { position: relative; padding-block: clamp(4.5rem, 9vw, 8rem); }
  .sec-tight { position: relative; padding-block: clamp(3.5rem, 7vw, 5.5rem); }
  .sec-join { padding-top: 0; }
  .sec-rule::before { content: ""; position: absolute; top: 0; left: var(--gutter); right: var(--gutter); height: 1px; background: var(--hx-line); }

  /* Type */
  .hx h1, .hx h2, .hx h3 { font-family: var(--hx-serif); font-weight: 500; letter-spacing: 0; line-height: 1.15; }
  .eyebrow-hx { font-size: .75rem; font-weight: 600; letter-spacing: .18em; text-transform: uppercase; color: var(--hx-bronze); }
  .dark .eyebrow-hx, .pillar-dark .eyebrow-hx { color: var(--hx-copper-light); }
  .h2 { margin-top: 1rem; font-size: clamp(2rem, 4vw, 3.25rem); text-wrap: balance; }
  .h2-sm { font-size: clamp(1.65rem, 2.8vw, 2.4rem); }
  .h3 { font-size: clamp(1.4rem, 2.2vw, 1.9rem); }
  .h4 { font-size: 1.35rem; }
  .lead { margin-top: 1.25rem; font-size: clamp(1.075rem, 1.4vw, 1.2rem); line-height: 1.65; max-width: 60ch; }
  .dark .lead { color: var(--hx-ivory); }
  .head-hx { max-width: 46rem; }

  /* Buttons: flat Copper, Deep Bronze on hover. Text is 19px bold so it meets AA contrast as large text. */
  .actions { display: flex; flex-wrap: wrap; gap: .9rem; margin-top: 2.25rem; }
  .actions-center { justify-content: center; }
  .btn-hx { display: inline-flex; align-items: center; justify-content: center; min-height: 3.25rem; padding: .75rem 1.6rem; border: 1px solid var(--hx-copper); border-radius: var(--hx-radius); background: var(--hx-copper); color: #fff; font-size: 1.1875rem; font-weight: 700; line-height: 1.25; text-align: center; text-decoration: none; transition: background-color .25s, border-color .25s, color .25s; }
  .btn-hx:hover { background: var(--hx-bronze); border-color: var(--hx-bronze); }
  .btn-hx-ghost { background: transparent; border-color: rgb(248 244 236 / .6); color: var(--hx-ivory); }
  .btn-hx-ghost:hover { background: rgb(248 244 236 / .08); border-color: var(--hx-ivory); }
  .ivory .btn-hx-ghost, .sand .btn-hx-ghost { border-color: var(--hx-graphite); color: var(--hx-graphite); }
  .ivory .btn-hx-ghost:hover, .sand .btn-hx-ghost:hover { background: var(--hx-graphite); color: var(--hx-ivory); }
  .mt-btn { margin-top: 2.25rem; }

  /* 1 | Hero */
  .hero { position: relative; overflow: hidden; display: flex; flex-direction: column; }
  .hero-inner { position: relative; padding-top: calc(var(--header-h) + clamp(2.5rem, 7vh, 5rem)); padding-bottom: 1rem; }
  .hero-title { margin-top: 1.25rem; font-size: clamp(2.6rem, 6.4vw, 5.25rem); line-height: 1.05; max-width: 12ch; }
  .hero-tagline { margin-top: 1.25rem; font-family: var(--hx-serif); font-size: clamp(1.3rem, 2vw, 1.6rem); color: var(--hx-copper-light); }
  .hero-intro { margin-top: 1.25rem; max-width: 34rem; font-size: clamp(1.075rem, 1.4vw, 1.2rem); line-height: 1.65; }
  .trust { margin-top: 1.25rem; font-size: .9rem; color: var(--hx-taupe); }
  .hero-art { order: 2; display: block; width: min(92%, 26rem); margin: 1.5rem auto 3rem; }
  .hero-art img { width: 100%; height: auto; -webkit-mask-image: radial-gradient(circle, #000 58%, transparent 71%); mask-image: radial-gradient(circle, #000 58%, transparent 71%); }
  @media (min-width: 48rem) {
    .hero { min-height: min(100svh, 56rem); justify-content: center; }
    .hero-art { position: absolute; inset: 0; width: 100%; margin: 0; }
    .hero-art img { height: 100%; object-fit: cover; object-position: 78% 50%; -webkit-mask-image: none; mask-image: none; }
    .hero-inner { padding-bottom: clamp(4rem, 8vh, 6rem); }
    .hero-inner > * { max-width: 34rem; }
    .hero-title { max-width: 12ch; }
  }
  @media (min-width: 48rem) and (max-width: 63.99rem) {
    /* Keep the copy clear of the knot on tablets */
    .hero-art img { opacity: .55; object-position: 100% 50%; }
  }

  /* Corner frames (open knot), decorative only */
  .has-corner { overflow: hidden; }
  .hx :global(.corner) { display: none; }
  @media (min-width: 64rem) {
    .hx :global(.corner) { display: block; position: absolute; width: 20rem; height: auto; opacity: .2; pointer-events: none; }
    .hx :global(.corner-tr) { top: -2rem; right: -3rem; }
    .hx :global(.corner-bl) { bottom: -3rem; left: -3rem; }
  }
  .has-corner > .wrap { position: relative; }

  /* 2 | Knot definition list */
  .two-col { display: grid; gap: clamp(2.5rem, 6vw, 5rem); align-items: start; }
  @media (min-width: 64rem) { .two-col { grid-template-columns: 1fr 1fr; } }
  .terms { border-top: 1px solid var(--hx-line); }
  .term { display: grid; gap: .35rem 1.5rem; padding-block: 1.4rem; border-bottom: 1px solid var(--hx-line); }
  .term dt { font-family: var(--hx-serif); font-weight: 500; font-size: 1.75rem; line-height: 1.2; color: var(--hx-copper); }
  .term dd { font-size: 1.075rem; }
  @media (min-width: 40rem) { .term { grid-template-columns: 9.5rem 1fr; align-items: baseline; } }

  /* 3 | Pillars */
  .pillars { display: grid; gap: 1.25rem; }
  @media (min-width: 56rem) { .pillars { grid-template-columns: repeat(3, 1fr); } }
  .pillar { display: grid; align-content: start; gap: 1rem; padding: clamp(1.75rem, 3vw, 2.5rem); border: 1px solid var(--hx-line); border-radius: var(--hx-radius); background: color-mix(in srgb, var(--hx-sand) 16%, var(--hx-ivory)); }
  .pillar-dark { background: var(--hx-graphite); border-color: var(--hx-graphite); color: var(--hx-ivory); }

  /* 4 | Inside every Hive */
  .showcase { margin-top: clamp(2.5rem, 5vw, 4rem); border-radius: var(--hx-radius); overflow: hidden; }
  .showcase :global(img) { width: 100%; height: auto; display: block; }
  .spaces { display: grid; gap: 0; margin-top: clamp(2.5rem, 5vw, 4rem); border-top: 1px solid var(--hx-line); }
  .space { display: grid; gap: .6rem; align-content: start; padding: 1.75rem 0; border-bottom: 1px solid var(--hx-line); }
  .space p { color: var(--hx-ivory); opacity: .9; }
  .hex { width: 2.25rem; height: 2.25rem; fill: none; stroke: var(--hx-copper); stroke-width: 1.5; stroke-linejoin: round; }
  @media (min-width: 40rem) {
    .spaces { grid-template-columns: repeat(2, 1fr); column-gap: 2.5rem; }
  }
  @media (min-width: 64rem) {
    .spaces { grid-template-columns: repeat(4, 1fr); column-gap: 2rem; border-top: 0; }
    .space { border-bottom: 0; border-top: 1px solid var(--hx-line); padding-top: 2rem; }
  }

  /* 5 | Feature rows */
  .rows { display: grid; gap: clamp(4rem, 8vw, 7rem); }
  .row { display: grid; gap: clamp(1.75rem, 4vw, 4rem); align-items: center; }
  .row-media { border-radius: var(--hx-radius); overflow: hidden; border: 1px solid var(--hx-line); }
  .row-media :global(img) { width: 100%; height: auto; display: block; }
  .row-text { display: grid; gap: 1rem; max-width: 34rem; }
  @media (min-width: 64rem) {
    .row { grid-template-columns: 1.15fr 1fr; }
    .row-flip { grid-template-columns: 1fr 1.15fr; }
    .row-flip .row-media { order: 2; }
  }

  /* 6 | What the knot means */
  .meaning { display: grid; gap: clamp(2.5rem, 5vw, 5rem); align-items: center; }
  .meaning-art { max-width: 32rem; width: 100%; margin-inline: auto; }
  .meaning-art :global(img) { width: 100%; height: auto; display: block; border-radius: var(--hx-radius); }
  @media (min-width: 64rem) { .meaning { grid-template-columns: .9fr 1.1fr; } }
  .points { margin-top: 2rem; border-top: 1px solid var(--hx-line); }
  .point { padding-block: 1rem; border-bottom: 1px solid var(--hx-line); }
  .point dt { font-weight: 700; }
  .point dd { margin-top: .2rem; }
  .closing { margin-top: 1.75rem; font-family: var(--hx-serif); font-size: clamp(1.15rem, 1.6vw, 1.35rem); line-height: 1.5; }

  /* 7 | Free to start */
  .promises { display: grid; border-top: 1px solid var(--hx-line); }
  .promises li { position: relative; padding: 1.4rem 0 1.4rem 2.5rem; border-bottom: 1px solid var(--hx-line); font-size: 1.1rem; }
  .promises li::before { content: ""; position: absolute; left: 0; top: 1.65rem; width: 1.15rem; height: 1.15rem; background: var(--hx-copper); clip-path: polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%); }
  .promises strong { font-weight: 700; }

  /* 8 | Steps */
  .steps { display: grid; gap: 1.25rem; margin-top: clamp(2rem, 4vw, 3rem); }
  @media (min-width: 56rem) { .steps { grid-template-columns: repeat(3, 1fr); gap: 2rem; } }
  .step { display: grid; gap: 1rem; align-content: start; padding-top: 1.5rem; border-top: 1px solid var(--hx-line); }
  .step-n { font-family: var(--hx-serif); font-size: 3rem; line-height: 1; color: var(--hx-copper); }

  /* 9 | Enterprise */
  .enterprise { display: grid; gap: 2rem; align-items: end; }
  .enterprise .lead { max-width: 52ch; }
  @media (min-width: 64rem) { .enterprise { grid-template-columns: 1fr auto; } }

  /* 10 | FAQ */
  .faq-wrap { max-width: 56rem; }
  .faq { margin-top: clamp(2rem, 4vw, 3rem); border-top: 1px solid var(--hx-line); }
  .faq-item { border-bottom: 1px solid var(--hx-line); }
  .hx .faq-q { font-family: var(--font-sans); font-size: 1.125rem; font-weight: 600; line-height: 1.4; }
  .faq-q button { width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; padding: 1.25rem 0; text-align: left; cursor: pointer; color: inherit; font: inherit; }
  .faq-q button:hover { color: var(--hx-bronze); }
  .faq-icon { position: relative; flex: none; width: 1.1rem; height: 1.1rem; }
  .faq-icon::before, .faq-icon::after { content: ""; position: absolute; left: 0; right: 0; top: 50%; height: 2px; margin-top: -1px; background: var(--hx-copper); transition: transform .3s var(--ease-flow); }
  .faq-icon::after { transform: rotate(90deg); }
  [aria-expanded="true"] .faq-icon::after { transform: rotate(0deg); }
  .faq-a { padding: 0 2.5rem 1.5rem 0; max-width: 65ch; }

  /* 11 | CTA band */
  .cta-band { position: relative; overflow: hidden; background: var(--hx-umber); color: var(--hx-ivory); padding-block: clamp(5rem, 10vw, 8rem); text-align: center; }
  .cta-band :global(.cta-bg) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; pointer-events: none; }
  .cta-inner { position: relative; max-width: 58rem; display: grid; justify-items: center; }
  .cta-title { margin-top: 0; font-size: clamp(1.75rem, 3.4vw, 2.75rem); }
  .cta-band .lead { margin-inline: auto; color: var(--hx-ivory); }
  .signoff { margin-top: 2rem; font-size: .9rem; color: var(--hx-ivory); opacity: .85; }

  /* Entrance: subtle fade and 8px rise, off when reduced motion is set */
  :global(.js) .hx .reveal { transform: translateY(8px); transition: opacity .7s var(--ease-flow), transform .7s var(--ease-flow); transition-delay: var(--d, 0ms); }
  :global(.js) .hx .reveal:global(.in) { transform: none; }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .hx .reveal { opacity: 1; transform: none; transition: none; }
    .faq-icon::before, .faq-icon::after, .btn-hx { transition: none; }
  }
</style>

<script>
  // FAQ accordion. Answers are open without JavaScript; with it, they start closed.
  const faq = document.querySelector<HTMLElement>('[data-faq]');
  if (faq) {
    const btns = [...faq.querySelectorAll<HTMLButtonElement>('[data-faq-btn]')];
    const set = (b: HTMLButtonElement, open: boolean) => {
      b.setAttribute('aria-expanded', String(open));
      document.getElementById(b.getAttribute('aria-controls')!)!.hidden = !open;
    };
    btns.forEach((b) => {
      set(b, false);
      b.addEventListener('click', () => set(b, b.getAttribute('aria-expanded') !== 'true'));
      b.addEventListener('keydown', (e) => {
        const i = btns.indexOf(b);
        const to = e.key === 'ArrowDown' ? btns[(i + 1) % btns.length] : e.key === 'ArrowUp' ? btns[(i - 1 + btns.length) % btns.length] : e.key === 'Home' ? btns[0] : e.key === 'End' ? btns[btns.length - 1] : null;
        if (to) { e.preventDefault(); to.focus(); }
      });
    });
  }
</script>
