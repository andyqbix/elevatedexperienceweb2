---
// HX Enterprise page: /hx-enterprise/
// Sits under Resources in the menu, after HX | Hive eXperience. Same HX palette, fonts, app icons and screens
// as /hx-hive-experience/, so the two pages look and read as one family.
// Copy: src/content/hx-enterprise.ts (app cards and testimonials are shared with the HX page).
import { Picture, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '@/layouts/Base.astro';
import { hxEnterprise as c } from '@/content/hx-enterprise';
import { links, site } from '@/data/site';
import knotFallback from '@/assets/hx/hx-hero-mobile.png';
import homeFallback from '@/assets/hx/hx-feature-home.png';

// Find a supplied image in src/assets/hx/landing/ by file name (any extension, ignoring case and accents), as on the HX page.
const supplied = import.meta.glob<ImageMetadata>('/src/assets/hx/landing/**/*.{png,jpg,jpeg,webp,avif}', { eager: true, import: 'default' });
const norm = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
const asset = (name: string): ImageMetadata | undefined => {
  const key = Object.keys(supplied).find((k) => norm(k.split('/').pop()!.replace(/\.[^.]+$/, '')) === norm(name));
  return key ? supplied[key] : undefined;
};

const knotSupplied = asset('hx-belonging-knot');
const knot = knotSupplied ?? knotFallback;
// The knot with the full "HX HIVE eXperience" logo, as in the HX page hero, never shown larger than its real size.
const heroKnot = asset('hx-hero-knot');
const screenHome = asset('hx-screen-home') ?? homeFallback;
const phones = c.modules.inAction.map((p) => ({ ...p, src: asset(p.img) })).filter((p) => p.src) as (typeof c.modules.inAction[number] & { src: ImageMetadata })[];
const cards = c.modules.items.map((a) => ({ ...a, img: asset(a.icon), nameBreakable: a.name.replace(/([a-zé])([A-Z])/g, '$1<wbr>$2') }));

const opaque = [knotFallback, homeFallback, screenHome];
const fallbackOf = (img: ImageMetadata) => (img.format === 'png' && !opaque.includes(img) ? 'png' : 'jpg') as 'png' | 'jpg';
const lazy = { loading: 'lazy' as const, decoding: 'async' as const };

const abs = (p: string) => new URL(p, site.url).href;
const og = await getImage({ src: knot, format: 'jpg', width: 1200, height: 630, fit: 'contain', background: '#2F2F2F' } as any);
const mail = `mailto:${c.cta.email}?subject=HX%20Enterprise`;
const ext = { target: '_blank', rel: 'noopener noreferrer' };

const schema = [
  {
    '@type': 'Service', '@id': abs(links.hxEnterprise) + '#service', name: 'HX Enterprise', serviceType: 'White label community platform',
    description: c.meta.description, url: abs(links.hxEnterprise), provider: { '@id': site.url + '/#organization' }, areaServed: 'Worldwide',
    offers: [
      { '@type': 'Offer', name: 'Platform licence', price: '498', priceCurrency: 'GBP', description: c.pricing.platform.unit },
      { '@type': 'Offer', name: 'Per seat', price: '0.98', priceCurrency: 'GBP', description: c.pricing.seat.unit },
    ],
  },
  {
    '@type': 'FAQPage', '@id': abs(links.hxEnterprise) + '#faq',
    mainEntity: c.faq.items.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---
<Base
  title={c.meta.title}
  description={c.meta.description}
  breadcrumb="HX Enterprise"
  parent={{ name: 'Resources', href: links.resources }}
  shareImage={{ src: abs(og.src), alt: c.hero.alt }}
  schema={schema}
>
  <div class="hxl">
    <!-- HERO -->
    <section class="hero dark">
      <div class="wrap hero-grid">
        <div>
          <p class="label">{c.hero.label}</p>
          <h1 class="hero-title">{c.hero.heading}</h1>
          <p class="purpose">{c.hero.purpose}</p>
          <p class="tagline">{c.hero.tagline}</p>
          <p class="hero-text">{c.hero.body}</p>
          <div class="actions">
            <a class="btn-hx" href={mail}>{c.hero.primary}</a>
            <a class="btn-hx btn-hx-ghost" href={links.bookCall} {...ext}>{c.hero.secondary}<span class="sr-only"> (opens in a new tab)</span></a>
          </div>
        </div>
        {heroKnot ? (
          <div class="hero-art hero-art-logo">
            <Picture src={heroKnot} alt={c.hero.alt} widths={[heroKnot.width]} sizes={`${heroKnot.width}px`} formats={['webp']} fallbackFormat="png" loading="eager" fetchpriority="high" decoding="async" />
          </div>
        ) : (
          <div class:list={['hero-art', !knotSupplied && 'knot-blend']}>
            <Picture src={knot} alt={c.hero.alt} widths={[400, 600, 800]} sizes="(min-width: 64rem) 26rem, (min-width: 30rem) 20rem, 72vw" formats={['webp']} fallbackFormat="png" loading="eager" fetchpriority="high" decoding="async" />
          </div>
        )}
      </div>
    </section>

    <!-- THE PROBLEM: TOO MANY PLATFORMS -->
    <section class="sec ivory">
      <div class="wrap prose reveal">
        <h2 class="h2 h2-wide">{c.problem.heading.split(/(?<=[.…])\s+/).map((phrase, i) => <>{i > 0 && ' '}<span class="keep">{phrase}</span></>)}</h2>
        {c.problem.intro.map((p) => <p>{p}</p>)}
        <p class="closing">{c.problem.closing}</p>
      </div>
    </section>

    <!-- 01 | WHAT YOUR PEOPLE GET: the same HX apps and screens as the HX page -->
    <section class="sec ivory sec-rule" id="apps">
      <div class="wrap">
        <div class="prose reveal">
          <h2 class="h2"><span class="num" aria-hidden="true">{c.modules.label}</span>{c.modules.heading}</h2>
          <p>{c.modules.intro}</p>
        </div>
        {(['photo', 'symbol'] as const).map((row) => (
          <ul class:list={['apps', `apps-${row}`]}>
            {cards.filter((a) => a.row === row).map((a, i) => (
              <li class="app reveal" style={`--d:${(i % 4) * 60}ms`}>
                {a.img ? (
                  <Picture src={a.img} alt={`${a.name} app icon`} widths={[80, 160, 240]} sizes="80px" formats={['webp']} fallbackFormat={fallbackOf(a.img)} class="app-icon" {...lazy} />
                ) : (
                  <svg class="app-icon app-hex" viewBox="0 0 24 24" aria-hidden="true"><polygon points="12 2 20.66 7 20.66 17 12 22 3.34 17 3.34 7" /></svg>
                )}
                <h3 class="app-name" set:html={a.nameBreakable} />
                <p>{a.text}</p>
              </li>
            ))}
          </ul>
        ))}
        <figure class="screens reveal">
          <div class="screens-row">
            <Picture src={screenHome} alt={c.modules.homeAlt} widths={[640, 960, 1280, 1600]} sizes="(min-width: 64rem) 60rem, 92vw" formats={['webp']} fallbackFormat={fallbackOf(screenHome)} {...lazy} />
          </div>
          {phones.length > 0 && (
            <ul class="phones">
              {phones.map((p) => (
                <li class="phone">
                  <div class="phone-frame">
                    <Picture src={p.src} alt={p.alt} widths={[320, 480, 640]} sizes="(min-width: 64rem) 18rem, (min-width: 40rem) 30vw, 80vw" formats={['webp']} fallbackFormat="jpg" {...lazy} />
                  </div>
                  <h3 class="phone-label">{p.label}</h3>
                  <p class="phone-text">{p.text}</p>
                </li>
              ))}
            </ul>
          )}
          <figcaption>{c.modules.caption}</figcaption>
        </figure>
      </div>
    </section>

    <!-- THE PROMISE -->
    <section class="sec dark">
      <div class="wrap">
        <div class="promise-head reveal">
          <h2 class="h2">{c.promise.heading}</h2>
          <p class="promise-sub">{c.promise.subheading}</p>
          {c.promise.intro.map((p) => <p class="promise-intro">{p}</p>)}
        </div>
        <p class="promise-label reveal">{c.promise.label}</p>
        <ul class="promise">
          {c.promise.points.map((p, i) => (
            <li class="reveal" style={`--d:${i * 90}ms`}>
              <h3 class="promise-h">{p.heading}<span class="promise-h-sub">{p.sub}</span></h3>
              <p>{p.text}</p>
            </li>
          ))}
        </ul>
        <div class="promise-close reveal">
          <p class="promise-closing">{c.promise.closing}</p>
        </div>
      </div>
    </section>

    <!-- WHO IT'S FOR -->
    <section class="sec ivory">
      <div class="wrap who reveal">
        <h2 class="h2">{c.who.heading}</h2>
        <p class="who-p">{c.who.intro}</p>
        <ul class="pills">
          {c.who.pills.map((p) => <li>{p}</li>)}
        </ul>
      </div>
    </section>

    <!-- 02 | WHAT'S INCLUDED + PRICING -->
    <section class="sec ivory sec-rule">
      <div class="wrap licence-grid">
        <div class="reveal">
          <h2 class="h2"><span class="num" aria-hidden="true">{c.licence.label}</span>{c.licence.heading}</h2>
          <ul class="ticks">
            {c.licence.items.map((l) => <li><strong>{l.lead}</strong> {l.text}</li>)}
          </ul>
        </div>
        <aside class="ent-price reveal" style="--d:90ms" aria-labelledby="price-label">
          <p class="price-label" id="price-label">{c.pricing.label}</p>
          <p class="price-row"><span class="price-big">{c.pricing.platform.price}</span> <span class="price-unit">{c.pricing.platform.unit}</span></p>
          <p class="price-row price-row-2"><span class="price-mid">{c.pricing.seat.price}</span> <span class="price-unit">{c.pricing.seat.unit}</span></p>
          <p class="price-note">{c.pricing.note} <strong>{c.pricing.noteBold}</strong></p>
        </aside>
      </div>
      <ul class="wrap assurances reveal">
        {c.assurances.map((a) => <li>{a}</li>)}
      </ul>
    </section>

    <!-- WHAT HIVERS SAY (same quotes as the HX page) -->
    <section class="sec ivory sec-rule">
      <div class="wrap">
        <h2 class="h2 reveal">{c.testimonials.heading}</h2>
        <div class="quotes">
          {c.testimonials.items.map((t, i) => (
            <figure class="quote reveal" style={`--d:${i * 90}ms`}>
              <span class="quote-mark" aria-hidden="true">&ldquo;</span>
              <blockquote><p>{t.quote}</p></blockquote>
              <figcaption><strong>{t.name}</strong><span>{t.title}</span></figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- CALL TO ACTION -->
    <section class="sec dark">
      <div class="wrap cta reveal">
        <h2 class="h2">{c.cta.heading}</h2>
        <p class="cta-mail"><a class="link-sand" href={mail}>{c.cta.email}</a></p>
        <div class="actions actions-center">
          <a class="btn-hx" href={mail}>{c.cta.primary}</a>
          <a class="btn-hx btn-hx-ghost" href={links.bookCall} {...ext}>{c.cta.secondary}<span class="sr-only"> (opens in a new tab)</span></a>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="sec ivory" id="faq">
      <div class="wrap faq-wrap">
        <h2 class="h2 reveal">{c.faq.heading}</h2>
        <div class="faq" data-faq>
          {c.faq.items.map((f, i) => (
            <div class="faq-item">
              <h3 class="faq-q">
                <button type="button" id={`faq-btn-${i}`} aria-expanded="true" aria-controls={`faq-panel-${i}`} data-faq-btn>
                  <span>{f.q}</span>
                  <span class="faq-icon" aria-hidden="true"></span>
                </button>
              </h3>
              <div class="faq-a" id={`faq-panel-${i}`} role="region" aria-labelledby={`faq-btn-${i}`}>
                <p>{f.a}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- BACK TO HX -->
    <section class="back ivory sec-rule">
      <div class="wrap back-row">
        <p class="back-label">{c.back.label}</p>
        <a class="btn-hx btn-hx-outline" href={c.back.href}>{c.back.cta}</a>
      </div>
    </section>
  </div>
</Base>

<style>
  .hxl {
    --hx-graphite: #2f2f2f;
    --hx-ivory: #f8f4ec;
    --hx-copper: #b96e50;
    --hx-bronze: #9a4e25;
    --hx-copper-light: #d3854f;
    --hx-sand: #eeb37c;
    --hx-peach: #f6cb9d;
    --hx-umber: #4e3f36;
    --hx-line: rgb(158 147 136 / .35);
    --hx-radius: 6px;
    font-family: var(--font-sans);
    background: var(--hx-ivory);
    color: var(--hx-graphite);
    overflow-x: clip;
  }
  .hxl :focus-visible { outline: 3px solid var(--hx-sand); outline-offset: 3px; border-radius: 2px; }
  .ivory :focus-visible { outline-color: var(--hx-bronze); }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .dark { background: var(--hx-graphite); color: var(--hx-ivory); }
  .ivory { background: var(--hx-ivory); color: var(--hx-graphite); }
  .sec { position: relative; padding-block: clamp(4.5rem, 9vw, 7rem); }
  .sec-rule::before { content: ""; position: absolute; top: 0; left: var(--gutter); right: var(--gutter); height: 1px; background: var(--hx-line); }

  .hxl h1, .hxl h2, .hxl h3 { font-family: var(--font-display); font-weight: 700; letter-spacing: -0.015em; line-height: 1.1; }
  .label { font-size: .8rem; font-weight: 600; letter-spacing: .16em; text-transform: uppercase; color: var(--hx-copper-light); }
  .h2 { font-size: clamp(1.9rem, 3.8vw, 3rem); text-wrap: balance; }
  .h2-wide { max-width: none; }
  .num { display: inline-block; margin-right: .6rem; font-size: .55em; vertical-align: .35em; color: var(--hx-bronze); }
  /* Each short phrase in a heading stays on one line (e.g. "Too Many Logins."), from tablet up */
  @media (min-width: 40rem) { .keep { white-space: nowrap; } }
  .prose > p { margin-top: 1.15rem; font-size: 1.075rem; line-height: 1.7; max-width: 62ch; }
  .prose > .h2 + p { margin-top: 1.75rem; }
  .prose > .closing { margin-top: 1.75rem; font-family: var(--font-display); font-weight: 700; font-size: clamp(1.3rem, 2vw, 1.6rem); line-height: 1.4; color: var(--hx-bronze); max-width: none; }

  /* Hero */
  .hero-grid { display: grid; gap: 2.5rem; padding-top: calc(var(--header-h) + clamp(2.5rem, 7vh, 4.5rem)); padding-bottom: clamp(3.5rem, 7vw, 6rem); }
  .hero-title { margin-top: 1.25rem; font-size: clamp(2.6rem, 6vw, 4.75rem); }
  .purpose { margin-top: 1rem; font-family: var(--font-display); font-weight: 700; font-size: clamp(1.2rem, 1.8vw, 1.5rem); color: var(--hx-sand); }
  .tagline { margin-top: .4rem; font-style: italic; font-size: 1.05rem; color: var(--hx-ivory); opacity: .9; }
  .hero-text { margin-top: 1.5rem; font-size: clamp(1.1rem, 1.5vw, 1.2rem); line-height: 1.65; max-width: 40rem; }
  .hero-art { width: min(72%, 20rem); justify-self: center; }
  .hero-art.hero-art-logo { width: min(100%, 25rem); }
  .hero-art :global(img) { display: block; width: 100%; height: auto; }
  .knot-blend :global(img) { -webkit-mask-image: radial-gradient(circle, #000 58%, transparent 71%); mask-image: radial-gradient(circle, #000 58%, transparent 71%); }
  @media (min-width: 64rem) {
    .hero-grid { grid-template-columns: 1.2fr .8fr; align-items: center; gap: clamp(2rem, 5vw, 5rem); min-height: min(90svh, 46rem); }
    .hero-art { width: 100%; max-width: 26rem; justify-self: end; }
    .hero-art-logo { max-width: 25rem; justify-self: center; }
  }

  /* Buttons: flat Copper with ivory text, Deep Bronze on hover. 19px bold for AA contrast as large text. */
  .actions { display: flex; flex-wrap: wrap; gap: .9rem; margin-top: 2.25rem; }
  .actions-center { justify-content: center; }
  .btn-hx { display: inline-flex; align-items: center; justify-content: center; min-height: 3.25rem; padding: .75rem 1.6rem; border: 2px solid var(--hx-copper); border-radius: var(--hx-radius); background: var(--hx-copper); color: var(--hx-ivory); font-size: 1.1875rem; font-weight: 700; line-height: 1.25; text-align: center; text-decoration: none; transition: background-color .25s, border-color .25s, color .25s; }
  .btn-hx:hover { background: var(--hx-bronze); border-color: var(--hx-bronze); }
  .btn-hx-ghost { background: transparent; border-color: rgb(248 244 236 / .7); }
  .btn-hx-ghost:hover { background: rgb(248 244 236 / .1); border-color: var(--hx-ivory); }
  .btn-hx-outline { background: transparent; border-color: var(--hx-graphite); color: var(--hx-graphite); }
  .btn-hx-outline:hover { background: var(--hx-graphite); border-color: var(--hx-graphite); color: var(--hx-ivory); }

  /* 01 | App cards, as on the HX page. Photo cards: 1 / 2 / 4 per row. Symbol cards (6 here, with Recognition): 1 / 2 / 3 per row. */
  .apps { --gap: 1.25rem; display: flex; flex-wrap: wrap; justify-content: center; gap: var(--gap); margin-top: clamp(2.5rem, 5vw, 3.5rem); }
  .apps-symbol { margin-top: var(--gap); }
  .app { flex: 0 0 100%; display: grid; align-content: start; gap: .6rem; padding: 1.75rem; border: 1px solid var(--hx-line); border-radius: var(--hx-radius); background: var(--hx-ivory); }
  @media (min-width: 40rem) { .app { flex-basis: calc((100% - var(--gap)) / 2); } }
  @media (min-width: 56rem) { .apps-symbol .app { flex-basis: calc((100% - 2 * var(--gap)) / 3); } }
  @media (min-width: 64rem) {
    .apps-photo .app { flex-basis: calc((100% - 3 * var(--gap)) / 4); }
    .apps-symbol .app { padding: 1.5rem; }
    .apps-symbol .app :global(.app-icon) { width: 4rem; height: 4rem; }
  }
  .app :global(.app-icon) { display: block; width: 5rem; height: 5rem; object-fit: contain; margin-bottom: .5rem; }
  .app-hex { fill: none; stroke: var(--hx-copper); stroke-width: 1.25; stroke-linejoin: round; padding: .5rem; }
  .hxl .app-name { font-size: 1.35rem; color: var(--hx-bronze); overflow-wrap: break-word; }
  .app p { line-height: 1.6; }

  .screens { margin-top: clamp(3rem, 6vw, 4.5rem); }
  .screens-row { max-width: 60rem; margin-inline: auto; }
  .screens-row :global(img) { display: block; width: 100%; height: auto; border-radius: var(--hx-radius); border: 1px solid var(--hx-line); }
  .screens figcaption { margin-top: 1.5rem; text-align: center; font-family: var(--font-display); font-weight: 700; font-size: clamp(1.1rem, 1.6vw, 1.3rem); color: var(--hx-bronze); }
  .phones { display: grid; gap: 2rem; margin-top: clamp(2.5rem, 5vw, 3.5rem); justify-items: center; }
  @media (min-width: 40rem) { .phones { grid-template-columns: repeat(3, 1fr); gap: clamp(1rem, 3vw, 2.5rem); } }
  .phone { width: 100%; max-width: 18rem; text-align: center; }
  .phone-frame { aspect-ratio: 9 / 16; overflow: hidden; border-radius: 1.5rem; border: 6px solid var(--hx-graphite); background: #fff; box-shadow: 0 1px 2px rgb(78 63 54 / .1), 0 20px 40px -22px rgb(78 63 54 / .45); }
  .phone-frame :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; object-position: top; }
  .hxl .phone-label { margin-top: 1.1rem; font-size: 1.2rem; color: var(--hx-bronze); }
  .phone-text { margin-top: .4rem; font-size: .98rem; line-height: 1.55; }

  /* Promise */
  .promise-sub { margin-top: 1rem; font-family: var(--font-display); font-weight: 700; font-size: clamp(1.25rem, 2vw, 1.6rem); line-height: 1.3; color: var(--hx-sand); }
  .promise-intro { margin-top: 1.15rem; font-size: 1.075rem; line-height: 1.7; color: var(--hx-ivory); max-width: 62ch; }
  .promise-head > .promise-sub + .promise-intro { margin-top: 1.5rem; }
  .promise-label { margin-top: clamp(2.5rem, 5vw, 3.5rem); font-size: .85rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: var(--hx-sand); }
  .promise { display: grid; gap: 2rem; margin-top: 1.5rem; }
  @media (min-width: 56rem) { .promise { grid-template-columns: repeat(3, 1fr); gap: clamp(2rem, 4vw, 3.5rem); } }
  .promise li { padding-top: 1.5rem; border-top: 1px solid rgb(238 179 124 / .4); }
  .hxl .promise-h { font-size: clamp(1.5rem, 2.4vw, 1.9rem); color: var(--hx-sand); }
  .promise-h-sub { display: block; margin-top: .3rem; font-size: .7em; color: var(--hx-ivory); }
  .promise p { margin-top: .9rem; font-size: 1.075rem; line-height: 1.65; color: var(--hx-ivory); }
  .promise-close { margin-top: clamp(3rem, 6vw, 4.5rem); padding-top: 2rem; border-top: 1px solid rgb(238 179 124 / .4); text-align: center; }
  .promise-closing { font-family: var(--font-display); font-weight: 700; font-size: clamp(1.4rem, 2.6vw, 2rem); line-height: 1.3; color: var(--hx-ivory); }

  /* Who it's for */
  .who { max-width: 56rem; }
  .who-p { margin-top: 1.5rem; font-size: 1.075rem; line-height: 1.7; }
  .pills { display: flex; flex-wrap: wrap; gap: .6rem; margin-top: 1.75rem; }
  .pills li { padding: .5rem 1.05rem; border: 1px solid var(--hx-copper); border-radius: 999px; background: #fff; font-weight: 600; font-size: .95rem; color: var(--hx-graphite); }

  /* 02 | Licence and pricing */
  .licence-grid { display: grid; gap: clamp(2.5rem, 5vw, 4rem); align-items: start; }
  @media (min-width: 64rem) { .licence-grid { grid-template-columns: 1.2fr .8fr; } }
  .ticks { display: grid; gap: 1rem; margin-top: 2rem; }
  .ticks li { position: relative; padding-left: 2rem; font-size: 1.075rem; line-height: 1.6; }
  .ticks li::before { content: ""; position: absolute; left: .1rem; top: .35rem; width: .9rem; height: .5rem; border-left: 2px solid var(--hx-copper); border-bottom: 2px solid var(--hx-copper); transform: rotate(-45deg); }
  .ticks strong { font-weight: 700; }
