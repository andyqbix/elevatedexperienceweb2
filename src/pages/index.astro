---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
import LogoStrip from '@/components/LogoStrip.astro';
import PageHero from '@/components/PageHero.astro';
import Journey from '@/components/Journey.astro';
import { shineStages } from '@/content/shine';
import { home as c } from '@/content/home';
import { rich } from '@/lib/text';
import duo from '@/assets/photos/duo-studio-b-cutout.png';
import imgKeynote from '@/assets/photos/stage-duo-close.jpg';
import imgMasterclass from '@/assets/photos/masterclass-03.jpg';
import imgCoach from '@/assets/photos/duo-networking.jpg';
import dx from '@/assets/brand/dx-colour.png';
import ex from '@/assets/brand/ex-colour.png';
import cx from '@/assets/brand/cx-colour.png';
import pyramid from '@/assets/photos/flow-pyramid.jpg';

const marks = { dx, ex, cx } as const;
const accents = { dx: 'accent-blue', ex: 'accent-silver', cx: 'accent-gold' } as const;
const cues = { dx: 'digital', ex: 'people', cx: 'customer' } as const;
const serviceImg = { keynotes: imgKeynote, masterclasses: imgMasterclass, coachsulting: imgCoach } as const;
// Crop focus per photo: the keynote shot is framed so both Claire and Andy are fully in view
const servicePos = { keynotes: '92% 35%', masterclasses: '50% 50%', coachsulting: '50% 35%' } as const;
const serviceAlt = {
  keynotes: 'Andy Jarvis and Claire Boscq CSP presenting together on a conference stage',
  masterclasses: 'Claire and Andy facilitating an Executive Masterclass in Jersey',
  coachsulting: 'Claire and Andy in conversation with business leaders at an event',
} as const;
---
<Base title={c.meta.title} description={c.meta.description}>
  <!-- HERO | VIDEO BANNER -->
  <PageHero eyebrow={c.hero.identifier} title={c.hero.heading} video={{ src: '/video/home-hero.mp4', mobileSrc: '/video/home-hero-mobile.mp4', poster: '/video/home-hero-poster.jpg' }} position="50% 40%" wideTitle>
    <p class="hero-line">{c.hero.sub}</p>
    <a href="#problem" class="scroll-cue" aria-label="Scroll to the real issue"><span></span><Icon name="arrow-down" /></a>
  </PageHero>

  <!-- SECTION 1 | THE PROBLEM -->
  <section id="problem" class="section bg-charcoal">
    <div class="atmos"></div>
    <div class="wrap relative">
      <div class="intro-grid">
        <div class="reveal">
          <p class="eyebrow">{c.problem.eyebrow}</p>
          <h2 class="display-md mt-6">{c.problem.heading}</h2>
        </div>
        <div class="prose-ee reveal" style="--d:120ms">
          {c.problem.body.map((p) => <p set:html={rich(p)} />)}
        </div>
      </div>

      <p class="eyebrow no-rule label-center reveal">{c.problem.statsLabel}</p>
      <div class="stats">
        {c.problem.stats.map((s, i) => (
          <article class={`card card-hover accent-top stat ${accents[s.key as keyof typeof accents]} reveal`} style={`--d:${i * 120}ms`}>
            <header class="stat-head">
              <p class="stat-tag">{s.tag}</p>
              <span class="stat-cue"><Icon name={cues[s.key as keyof typeof cues]} /></span>
            </header>
            <p class="stat-figure" aria-label={`${s.figure}%`}><span data-count={s.figure}>{s.figure}</span><span class="pct">%</span></p>
            <h3 class="stat-title">{s.title}</h3>
            <p class="stat-text" set:html={rich(s.text)} />
            <footer class="stat-foot">
              <Image src={marks[s.key as keyof typeof marks]} alt="" height={40} class="stat-mark" />
              <cite>{s.source}</cite>
            </footer>
          </article>
        ))}
      </div>

      <div class="connection reveal">
        <p class="eyebrow no-rule">{c.problem.connectionLabel}</p>
        {c.problem.connection.map((p, i) => <p class={i === 0 ? 'kicker' : 'lede'} set:html={rich(p)} />)}
      </div>
    </div>
  </section>

  <section class="quote-band">
    <div class="wrap-narrow">
      <figure class="reveal">
        <blockquote class="display-lg"><span class="q">“</span>{c.problem.quote}<span class="q">”</span></blockquote>
        <figcaption>{c.problem.quoteBy}</figcaption>
      </figure>
    </div>
  </section>

  <!-- SECTION 2 | WHY US? THE POWER DUO -->
  <section class="section on-light">
    <div class="wrap split">
      <div class="split-media">
        <Image src={duo} alt="Claire Boscq CSP and Andy Jarvis, the Power Duo" widths={[480, 800, 1089]} sizes="(min-width: 64rem) 42vw, 92vw" format="webp" class="cutout reveal" />
      </div>
      <div class="split-copy">
        <p class="eyebrow reveal">{c.whyUs.eyebrow}</p>
        <h2 class="display-md mt-6 reveal">{c.whyUs.heading}</h2>
        <p class="kicker promise reveal">{c.whyUs.promise}</p>
        <p class="cred reveal">{c.whyUs.credibility}</p>
        <div class="prose-ee reveal">
          {c.whyUs.body.map((p) => <p set:html={rich(p)} />)}
        </div>
        <p class="closing reveal">{c.whyUs.closing}</p>
        <a class="btn btn-primary reveal" href={c.whyUs.cta.href}>{c.whyUs.cta.label} <Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <!-- SECTION 3 | THE SOLUTION -->
  <section class="section bg-ink shine">
    <div class="atmos atmos-gold"></div>
    <div class="wrap relative">
      <div class="shine-head">
        <p class="eyebrow reveal">{c.solution.eyebrow}</p>
        <h2 class="display-lg mt-6 reveal">{c.solution.heading}</h2>
      </div>
      <div class="stages reveal">
        <Journey id="home-shine" steps={shineStages} label="The six stages of the SHINE Blueprint" href={`${c.solution.cta.href}#stages`} />
      </div>
      <div class="shine-body reveal">
        <div class="prose-ee">
          {c.solution.short.map((p) => <p set:html={rich(p)} />)}
        </div>
        <a class="btn btn-gold" href={c.solution.cta.href}>{c.solution.cta.label} <Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <!-- SECTION 4 | THE DELIVERY -->
  <section class="section on-light">
    <div class="wrap">
      <div class="delivery-head">
        <div class="reveal">
          <p class="eyebrow">{c.delivery.eyebrow}</p>
          <h2 class="display-md mt-6">{c.delivery.heading}</h2>
        </div>
        <p class="lede reveal" style="--d:120ms">{c.delivery.intro}</p>
      </div>
      <p class="eyebrow no-rule label-center reveal">{c.delivery.label}</p>
      <div class="services">
        {c.delivery.services.map((s, i) => (
          <article class="card card-hover service reveal" style={`--d:${i * 120}ms`}>
            <div class="photo photo-zoom service-photo">
              <Image src={serviceImg[s.key as keyof typeof serviceImg]} alt={serviceAlt[s.key as keyof typeof serviceAlt]} widths={[400, 700, 1000]} sizes="(min-width: 64rem) 30vw, 92vw" style={`object-position:${servicePos[s.key as keyof typeof servicePos]}`} />
            </div>
            <div class="service-body">
              <p class="service-n">{String(i + 1).padStart(2, '0')}</p>
              <h3 class="display-sm">{s.title}</h3>
              <p class="service-text">{s.text}</p>
              <p class="service-outcome">{s.outcome}</p>
              <a class="btn btn-ghost" href={s.href}>{s.cta} <Icon name="arrow" /></a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- SECTION 5 | THE OUTCOME -->
  <section class="section bg-ink outcome">
    <div class="wrap outcome-grid">
      <div>
        <p class="eyebrow reveal">{c.outcome.eyebrow}</p>
        <h2 class="display-lg mt-6 reveal">{c.outcome.heading}</h2>
        <div class="prose-ee mt-8 reveal">
          {c.outcome.body.map((p) => <p set:html={rich(p)} />)}
        </div>
        <p class="closing-light reveal">{c.outcome.closing}</p>
      </div>
      <div class="pyramid reveal">
        <Image src={pyramid} alt="The Flow Pyramid: Customer eXperience at the top, Digital eXperience and Employee eXperience at the base, with copper, blue and silver light flowing together at the centre" widths={[480, 800, 1200, 1536]} sizes="(min-width: 64rem) 40vw, 92vw" />
      </div>
    </div>
  </section>

  <!-- SECTION 6 | THE PROOF -->
  <section class="section-tight bg-charcoal">
    <div class="wrap">
      <p class="eyebrow no-rule label-center reveal">{c.proof.eyebrow}</p>
    </div>
    <LogoStrip />
  </section>

  <!-- SECTION 7 | THE ACTION -->
  <section class="section on-copper action">
    <div class="wrap-narrow center">
      <p class="eyebrow no-rule reveal">{c.action.eyebrow}</p>
      <h2 class="display-lg mt-6 reveal">{c.action.heading}</h2>
      <p class="lede mt-6 reveal">{c.action.text}</p>
      <p class="mt-10 reveal"><a class="btn btn-primary" href={c.action.cta.href} target="_blank" rel="noopener noreferrer">{c.action.cta.label} <Icon name="external" /></a></p>
    </div>
  </section>
</Base>

<style>
  .relative { position: relative; }
  .center { text-align: center; }
  .label-center { display: flex; justify-content: center; text-align: center; margin-bottom: 2rem; }

  .scroll-cue { display: inline-grid; justify-items: center; gap: .3rem; color: var(--color-gold); padding: .5rem; margin-top: 2rem; }
  .scroll-cue span { width: 1px; height: 1.75rem; background: linear-gradient(180deg, transparent, var(--color-gold)); }
  .scroll-cue :global(svg) { width: 1.1rem; height: 1.1rem; animation: nudge 2.4s var(--ease-flow) infinite; }
  @keyframes nudge { 50% { transform: translateY(5px); } }

  /* Problem */
  .intro-grid { display: grid; gap: 2.5rem; margin-bottom: clamp(3.5rem, 7vw, 6rem); }
  .stats { display: grid; gap: 1.5rem; }
  .stat { padding: clamp(1.75rem, 3vw, 2.5rem); display: flex; flex-direction: column; }
  .stat-head { display: flex; align-items: center; justify-content: space-between; }
  .stat-tag { font-size: .72rem; font-weight: 700; letter-spacing: .24em; color: var(--accent-solid); }
  .stat-cue { width: 2.75rem; height: 2.75rem; border-radius: 50%; display: grid; place-items: center; color: var(--accent-solid); border: 1px solid color-mix(in srgb, var(--accent-solid) 40%, transparent); }
  .stat-cue :global(svg) { width: 1.25rem; height: 1.25rem; }
  .stat-figure { font-family: var(--font-display); font-weight: 800; font-size: clamp(5rem, 9vw, 7.5rem); line-height: .9; letter-spacing: -.04em; margin: 1.5rem 0 1rem; background: var(--accent); -webkit-background-clip: text; background-clip: text; color: transparent; font-variant-numeric: tabular-nums; }
  .stat-figure .pct { font-size: .5em; margin-left: .05em; }
  .stat-title { font-size: 1.45rem; line-height: 1.15; font-weight: 600; }
  .stat-text { margin-top: .9rem; color: rgb(255 255 255 / .74); font-size: .98rem; line-height: 1.6; flex: 1; }
  .stat-foot { margin-top: 1.75rem; padding-top: 1.1rem; border-top: 1px solid rgb(255 255 255 / .1); display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .stat-mark { height: 1.6rem; width: auto; opacity: .9; }
  .stat-foot cite { font-size: .8rem; font-style: italic; color: rgb(255 255 255 / .6); }
  .connection { max-width: 46rem; margin: clamp(3.5rem, 7vw, 6rem) auto 0; text-align: center; display: grid; gap: 1.1rem; justify-items: center; }

  .quote-band { background: linear-gradient(180deg, #17191d, #0b0c0f); padding-block: clamp(4rem, 9vw, 8rem); text-align: center; border-top: 1px solid rgb(255 255 255 / .05); }
  .quote-band blockquote { font-weight: 700; }
  .quote-band .q { color: var(--color-copper); }
  .quote-band figcaption { margin-top: 2rem; font-size: .78rem; font-weight: 600; letter-spacing: .24em; text-transform: uppercase; color: var(--color-gold); }

  /* Why us */
  .split { display: grid; gap: clamp(2.5rem, 6vw, 5.5rem); align-items: center; }
  .split-media { display: flex; justify-content: center; }
  .cutout { width: 100%; max-width: 32rem; height: auto; --fade: linear-gradient(180deg, #000 80%, transparent), linear-gradient(90deg, transparent, #000 9%, #000 91%, transparent); -webkit-mask-image: var(--fade); mask-image: var(--fade); -webkit-mask-composite: source-in; mask-composite: intersect; }
  .promise { margin-top: 1.5rem; color: var(--color-copper-deep); }
  .cred { margin: .9rem 0 1.75rem; font-size: .8rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: #5d6067; line-height: 1.6; }
  .closing { margin: 2rem 0; padding-left: 1.25rem; border-left: 3px solid var(--color-copper); font-family: var(--font-display); font-weight: 700; font-size: 1.35rem; line-height: 1.25; }

  /* SHINE */
  .shine-head { max-width: 56rem; }
  .stages { margin: clamp(2.5rem, 5vw, 4rem) 0; }
  .shine-body { display: grid; gap: 2rem; justify-items: start; }
  .shine-body .prose-ee { max-width: 46rem; }

  /* Delivery */
  .delivery-head { display: grid; gap: 2rem; margin-bottom: clamp(3rem, 6vw, 5rem); align-items: end; }
  .services { display: grid; gap: 1.5rem; }
  .service { overflow: hidden; display: flex; flex-direction: column; }
  .service-photo { border-radius: 0; aspect-ratio: 16 / 9; }
  .service-body { padding: clamp(1.5rem, 2.6vw, 2.25rem); display: flex; flex-direction: column; flex: 1; }
  .service-n { font-size: .72rem; font-weight: 700; letter-spacing: .24em; color: var(--color-copper-deep); margin-bottom: .6rem; }
  .service-text { margin-top: .9rem; color: #474a50; font-size: .98rem; line-height: 1.6; flex: 1; }
  .service-outcome { margin: 1.4rem 0 1.5rem; font-family: var(--font-display); font-weight: 700; font-size: 1.3rem; color: var(--color-copper-deep); }
  .service .btn { align-self: stretch; justify-content: center; white-space: nowrap; min-height: 3.25rem; padding-inline: 1rem; }

  /* Outcome */
  .outcome-grid { display: grid; gap: 3rem; align-items: center; }
  .closing-light { margin-top: 2rem; font-family: var(--font-display); font-weight: 700; font-size: clamp(1.3rem, 2.2vw, 1.75rem); line-height: 1.2; background: var(--grad-gold); -webkit-background-clip: text; background-clip: text; color: transparent; }
  /* Flow Pyramid: the artwork's black background melts into the section with a soft edge fade */
  .pyramid { width: min(100%, 34rem); margin-inline: auto; }
  .pyramid :global(img) { width: 100%; height: auto; display: block; --fade: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent), linear-gradient(180deg, transparent, #000 5%, #000 95%, transparent); -webkit-mask-image: var(--fade); mask-image: var(--fade); -webkit-mask-composite: source-in; mask-composite: intersect; }

  .action :global(.eyebrow) { color: var(--color-gold-pale); }

  @media (min-width: 48rem) {
    .stats { grid-template-columns: repeat(3, 1fr); }
    .shine-body { grid-template-columns: 1fr auto; gap: 4rem; align-items: end; }
  }
  @media (min-width: 64rem) {
    .intro-grid { grid-template-columns: 1.1fr 1fr; gap: 5rem; align-items: end; }
    .split { grid-template-columns: .85fr 1fr; }
    .delivery-head { grid-template-columns: 1fr 1fr; gap: 5rem; }
    .services { grid-template-columns: repeat(3, 1fr); }
    .outcome-grid { grid-template-columns: 1.15fr 1fr; gap: 5rem; }
  }
</style>

