<script>
  // FAQ accordion. Answers are open without JavaScript; with it, they start closed.
  const faq = document.querySelector<HTMLElement>('[data-faq]');
  if (faq) {
    const btns = [...faq.querySelectorAll<HTMLButtonElement>('[data-faq-btn]')];
    const set = (b: HTMLButtonElement, open: boolean) => {
      b.setAttribute('aria-expanded', String(open));
      document.getElementById(b.getAttribute('aria-controls')!)!.hidden = !open;
    };
    btns.forEach((b) => {
      set(b, false);
      b.addEventListener('click', () => set(b, b.getAttribute('aria-expanded') !== 'true'));
      b.addEventListener('keydown', (e) => {
        const i = btns.indexOf(b);
        const to = e.key === 'ArrowDown' ? btns[(i + 1) % btns.length] : e.key === 'ArrowUp' ? btns[(i - 1 + btns.length) % btns.length] : e.key === 'Home' ? btns[0] : e.key === 'End' ? btns[btns.length - 1] : null;
        if (to) { e.preventDefault(); to.focus(); }
      });
    });
  }
</script>
