---
// HX | Hive eXperience landing page: /hx-hive-experience/
// Sits under Resources in the menu (see nav in src/data/site.ts). The old /resources/hive-experience/
// address redirects here permanently (see vercel.json).
// Uses the HX Belonging Knot palette, scoped to this page as --hx- custom properties so it does not leak.
// Fonts match the rest of the site: League Spartan for headings, Montserrat for text (with its true italic).
//
// Images: drop the supplied artwork into src/assets/hx/landing/ using the file names below and the page
// picks them up on the next build. Until a file is there, the page shows the fallback noted beside it.
//   hx-belonging-knot.(png|jpg|webp)       Belonging Knot with HX logo   (fallback: existing copper knot)
//   hx-cx-dx-ex-diagram.(png|jpg|webp)     CX / DX / EX diagram          (fallback: section shows text only)
//   hx-screen-home.(png|jpg|webp)          HX home screen                (fallback: existing home screen)
//   hx-screen-your-hives.(png|jpg|webp)    "Your Hives" switcher         (fallback: not shown)
//   icons/HXCafe.jpg ... icons/HXPayment.jpg   13 app icons              (fallback: copper hexagon)
import '@fontsource-variable/montserrat/wght-italic.css';
import { Picture, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '@/layouts/Base.astro';
import { hxLanding as c } from '@/content/hx-hive-experience';
import { links, site } from '@/data/site';
import knotFallback from '@/assets/hx/hx-hero-mobile.png';
import ogFallback from '@/assets/hx/hx-hero-belonging-knot.png';
import homeFallback from '@/assets/hx/hx-feature-home.png';
import knotIvory from '@/assets/hx/hx-belonging-knot-ivory.png';

// Find a supplied image by file name (any extension, ignoring case and accents, so HXCafe and HXCafé both match).
const supplied = import.meta.glob<ImageMetadata>('/src/assets/hx/landing/**/*.{png,jpg,jpeg,webp,avif}', { eager: true, import: 'default' });
const norm = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
const asset = (name: string): ImageMetadata | undefined => {
  const key = Object.keys(supplied).find((k) => norm(k.split('/').pop()!.replace(/\.[^.]+$/, '')) === norm(name));
  return key ? supplied[key] : undefined;
};

const knotSupplied = asset('hx-belonging-knot');
const knot = knotSupplied ?? knotFallback;
// The knot with the full "HX HIVE eXperience" logo (600 x 600), used in the hero and the knot section,
// never shown larger than its real size.
const heroKnot = asset('hx-hero-knot');
const diagram = asset('hx-cx-dx-ex-diagram');
const screenHome = asset('hx-screen-home') ?? homeFallback;
const screenHives = asset('hx-screen-your-hives');
const screenNetwork = asset('hx-screen-network');
// Each app card with its icon. Long names may wrap between words (HXSocial|Media|Connector), never mid-word.
const cards = c.apps.cards.map((a) => ({ ...a, img: asset(a.icon), nameBreakable: a.name.replace(/([a-zé])([A-Z])/g, '$1<wbr>$2') }));

// Each picture is served as WebP with a fallback in its original format; width and height are set automatically.
// Logos keep PNG (they may have transparency); screenshots and the existing artwork are opaque, so JPG keeps them light.
const opaque = [knotFallback, homeFallback, screenHome, screenHives];
const fallbackOf = (img: ImageMetadata) => (img.format === 'png' && !opaque.includes(img) ? 'png' : 'jpg') as 'png' | 'jpg';
const lazy = { loading: 'lazy' as const, decoding: 'async' as const };

// Social sharing image: the Belonging Knot, 1200 x 630.
const og = knotSupplied
  ? await getImage({ src: knotSupplied, format: 'jpg', width: 1200, height: 630, fit: 'contain', background: '#2F2F2F' } as any)
  : await getImage({ src: ogFallback, format: 'jpg', width: 1200, height: 630, fit: 'cover' });

const abs = (p: string) => new URL(p, site.url).href;
const pricing = 'https://hive.elevatedexperience.vip/pricing';

const schema = [
  {
    '@type': 'SoftwareApplication', '@id': abs(links.hxPage) + '#software', name: 'HX | Hive eXperience',
    applicationCategory: 'SocialNetworkingApplication', operatingSystem: 'Web browser', url: links.hx,
    description: c.meta.description, image: abs(og.src),
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'GBP' },
    publisher: { '@id': site.url + '/#organization' },
  },
  {
    '@type': 'FAQPage', '@id': abs(links.hxPage) + '#faq',
    mainEntity: c.faq.items.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
const ext = { target: '_blank', rel: 'noopener noreferrer' };
---
<Base
  title={c.meta.title}
  exactTitle
  description={c.meta.description}
  breadcrumb="HX | Hive eXperience"
  parent={{ name: 'Resources', href: links.resources }}
  shareTitle={c.hero.heading}
  shareImage={{ src: abs(og.src), alt: c.hero.alt }}
  schema={schema}
>
  <div class="hxl">
    <!-- 1 | HERO -->
    <section class="hero dark">
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <p class="hero-brand">{c.hero.label}</p>
          <h1 class="hero-title">{c.hero.heading}</h1>
          <p class="hero-text">{c.hero.text}</p>
          <p class="hero-village">{c.hero.village}</p>
          <p class="hero-italic">{c.hero.italic}</p>
        </div>
        <p class="hero-cta hero-cta-1"><a class="btn-hx" href={links.hx} rel="noopener">{c.hero.primary}</a></p>
        <p class="hero-cta hero-cta-2">
          <a class="btn-hx btn-hx-ghost" href={links.hxHives} rel="noopener">{c.hero.browse}</a>
          <a class="btn-hx btn-hx-ghost" href={links.hxEvents} rel="noopener">{c.hero.events}</a>
        </p>
        {heroKnot ? (
          <div class="hero-art hero-art-logo">
            <Picture src={heroKnot} alt={c.hero.altLogo} widths={[heroKnot.width]} sizes={`${heroKnot.width}px`} formats={['webp']} fallbackFormat="png" loading="eager" fetchpriority="high" decoding="async" />
          </div>
        ) : (
          <div class:list={['hero-art', !knotSupplied && 'knot-blend']}>
            <Picture src={knot} alt={c.hero.alt} widths={[480, 720, 1080]} sizes="(min-width: 64rem) 34rem, (min-width: 30rem) 26rem, 88vw" formats={['webp']} fallbackFormat={fallbackOf(knot)} loading="eager" fetchpriority="high" decoding="async" />
          </div>
        )}
      </div>
    </section>

    <!-- 2 | WHY HX -->
    <section class="sec ivory">
      <div class:list={['wrap', diagram ? 'why-grid' : 'why-solo']}>
        <div class="prose reveal">
          <h2 class="h2">{c.why.heading}</h2>
          {c.why.body.map((p) => <p>{p}</p>)}
          <p class="why-closing">{c.why.closing}</p>
          <p class="why-bold"><strong>{c.why.bold}</strong></p>
          <p class="why-signoff"><em>{c.why.signoff}</em></p>
        </div>
        {diagram && (
          <figure class="why-art reveal" style="--d:90ms">
            <Picture src={diagram} alt={c.why.alt} widths={[480, 800, 1200]} sizes="(min-width: 64rem) 38vw, 92vw" formats={['webp']} fallbackFormat={fallbackOf(diagram)} {...lazy} />
          </figure>
        )}
      </div>
    </section>

    <!-- 3 | WHAT'S IN YOUR HIVE -->
    <section class="sec ivory sec-rule" id="whats-inside">
      <div class="wrap">
        <div class="head head-full prose reveal">
          <h2 class="h2">{c.apps.heading}</h2>
          {c.apps.intro.map((p) => <p>{p}</p>)}
          <p class="why-closing">{c.apps.introClosing}</p>
        </div>
        {(['photo', 'symbol'] as const).map((row) => (
          <ul class:list={['apps', `apps-${row}`]}>
            {cards.filter((a) => a.row === row).map((a, i) => (
              <li class="app reveal" style={`--d:${(i % 5) * 60}ms`}>
                {a.img ? (
                  <Picture src={a.img} alt={`${a.name} app icon`} widths={[80, 160, 240]} sizes="80px" formats={['webp']} fallbackFormat={fallbackOf(a.img)} class="app-icon" {...lazy} />
                ) : (
                  <svg class="app-icon app-hex" viewBox="0 0 24 24" aria-hidden="true"><polygon points="12 2 20.66 7 20.66 17 12 22 3.34 17 3.34 7" /></svg>
                )}
                <h3 class="app-name" set:html={a.nameBreakable} />
                <p>{a.text}</p>
              </li>
            ))}
          </ul>
        ))}
        <figure class="screens reveal">
          <div class:list={['screens-row', screenHives && 'screens-two']}>
            <Picture src={screenHome} alt={c.apps.homeAlt} widths={[640, 960, 1280, 1600]} sizes={screenHives ? '(min-width: 64rem) 46vw, 92vw' : '(min-width: 64rem) 60rem, 92vw'} formats={['webp']} fallbackFormat={fallbackOf(screenHome)} {...lazy} />
            {screenHives && <Picture src={screenHives} alt={c.apps.hivesAlt} widths={[640, 960, 1280, 1600]} sizes="(min-width: 64rem) 46vw, 92vw" formats={['webp']} fallbackFormat={fallbackOf(screenHives)} {...lazy} />}
          </div>
          <figcaption>{c.apps.caption}</figcaption>
        </figure>
      </div>
    </section>

    <!-- 5 | THE HX PROMISE -->
    <section class="sec dark">
      <div class="wrap">
        <div class="promise-head reveal">
          <h2 class="h2">{c.promise.heading}</h2>
          <p class="promise-sub">{c.promise.subheading}</p>
          {c.promise.intro.map((p) => <p class="promise-intro">{p}</p>)}
        </div>
        <p class="promise-label reveal">{c.promise.label}</p>
        <ul class="promise">
          {c.promise.points.map((p, i) => (
            <li class="reveal" style={`--d:${i * 90}ms`}>
              <h3 class="promise-h">{p.heading}<span class="promise-h-sub">{p.sub}</span></h3>
              <p>{p.text}</p>
            </li>
          ))}
        </ul>
        <div class="promise-close reveal">
          <p class="promise-closing">{c.promise.closing}</p>
        </div>
      </div>
    </section>

    <!-- 6 | WHO IT'S FOR, FREE TO JOIN (one section, with the Your Network screen) -->
    <section class="sec ivory">
      <div class:list={['wrap', screenNetwork ? 'join-grid' : 'join-solo']}>
        <div class="join-copy reveal">
          <h2 class="h2">{c.join.heading}</h2>
          <p class="join-p">{c.join.intro}</p>
          <ul class="pills">
            {c.join.pills.map((p) => <li>{p}</li>)}
          </ul>
          <p class="join-p">{c.join.text}</p>
          <h3 class="join-free">{c.join.freeHeading}</h3>
          <p class="join-p">{c.join.freeText} <a class="link-bronze" href={pricing} rel="noopener">{c.join.pricing}</a></p>
          <p class="mt-btn"><a class="btn-hx" href={links.hx} rel="noopener">{c.join.cta}</a></p>
        </div>
        {screenNetwork && (
          <figure class="join-art reveal" style="--d:90ms">
            <Picture src={screenNetwork} alt={c.join.networkAlt} widths={[480, 720, 1000]} sizes="(min-width: 64rem) 40vw, 92vw" formats={['webp']} fallbackFormat="jpg" {...lazy} />
          </figure>
        )}
      </div>
    </section>

    <!-- 9 | WHAT THE KNOT MEANS -->
    <section class="sec ivory sec-rule">
      <div class="wrap meaning">
        <div class="meaning-art reveal">
          {heroKnot
            ? <Picture src={heroKnot} alt={c.meaning.alt} widths={[heroKnot.width]} sizes={`${heroKnot.width}px`} formats={['webp']} fallbackFormat="png" {...lazy} />
            : <Picture src={knotIvory} alt={c.meaning.alt} widths={[480, 800, 1200]} sizes="(min-width: 64rem) 36vw, 92vw" formats={['webp']} fallbackFormat="jpg" {...lazy} />}
        </div>
        <div class="meaning-copy reveal" style="--d:90ms">
          <h2 class="h2 h2-sm">{c.meaning.heading}</h2>
          {c.meaning.body.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </section>

    <!-- WHAT HIVERS SAY (just before the FAQ) -->
    <section class="sec ivory sec-rule">
      <div class="wrap">
        <h2 class="h2 reveal">{c.testimonials.heading}</h2>
        <div class="quotes">
          {c.testimonials.items.map((t, i) => (
            <figure class="quote reveal" style={`--d:${i * 90}ms`}>
              <span class="quote-mark" aria-hidden="true">&ldquo;</span>
              <blockquote><p>{t.quote}</p></blockquote>
              <figcaption><strong>{t.name}</strong><span>{t.title}</span></figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- BIG STATEMENT AND CALL TO ACTION -->
    <section class="sec dark statement">
      <div class="wrap statement-inner reveal">
        <p class="statement-quote">{c.statement.quote}</p>
        <p class="statement-purpose">{c.statement.purpose}</p>
        <p class="mt-btn"><a class="btn-hx btn-hx-lg" href={links.hx} rel="noopener">{c.statement.cta}</a></p>
      </div>
    </section>

    <!-- 10 | FAQ -->
    <section class="sec ivory sec-rule" id="faq">
      <div class="wrap faq-wrap">
        <h2 class="h2 reveal">{c.faq.heading}</h2>
        <div class="faq" data-faq>
          {c.faq.items.map((f, i) => (
            <div class="faq-item">
              <h3 class="faq-q">
                <button type="button" id={`faq-btn-${i}`} aria-expanded="true" aria-controls={`faq-panel-${i}`} data-faq-btn>
                  <span>{f.q}</span>
                  <span class="faq-icon" aria-hidden="true"></span>
                </button>
              </h3>
              <div class="faq-a" id={`faq-panel-${i}`} role="region" aria-labelledby={`faq-btn-${i}`}>
                <p>{f.a}</p>
                {'links' in f && f.links && (
                  <ul class="faq-links">
                    {f.links.map((l) => l.external
                      ? <li><a href={l.href} {...ext}>{l.label}<span class="sr-only"> (opens in a new tab)</span></a></li>
                      : <li><a href={l.href}>{l.label}</a></li>)}
                  </ul>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  </div>
</Base>

<style>
  .hxl {
    /* HX Belonging Knot palette */
    --hx-graphite: #2f2f2f;
    --hx-ivory: #f8f4ec;
    --hx-copper: #b96e50;
    --hx-bronze: #9a4e25;
    --hx-copper-light: #d3854f;
    --hx-sand: #eeb37c;
    --hx-peach: #f6cb9d;
    --hx-taupe: #9e9388;
    --hx-umber: #4e3f36;
    --hx-line: rgb(158 147 136 / .35);
    --hx-radius: 6px;
    font-family: var(--font-sans);
    color: var(--hx-graphite);
    background: var(--hx-ivory);
    overflow-x: clip;
  }
  /* Visible focus: Sand on graphite, Deep Bronze on ivory */
  .hxl :focus-visible { outline: 3px solid var(--hx-sand); outline-offset: 3px; border-radius: 2px; }
  .ivory :focus-visible { outline-color: var(--hx-bronze); }

  /* Surfaces */
  .dark { background: var(--hx-graphite); color: var(--hx-ivory); }
  .ivory { background: var(--hx-ivory); color: var(--hx-graphite); }
  .sec { position: relative; padding-block: clamp(4.5rem, 9vw, 8rem); }
  .sec-rule::before { content: ""; position: absolute; top: 0; left: var(--gutter); right: var(--gutter); height: 1px; background: var(--hx-line); }
  .ivory + .sec-rule { padding-top: clamp(4rem, 8vw, 7rem); }

  /* Type */
  .hxl h1, .hxl h2, .hxl h3 { font-family: var(--font-display); font-weight: 700; letter-spacing: -0.015em; line-height: 1.1; }
  .label { font-size: .8rem; font-weight: 600; letter-spacing: .16em; text-transform: uppercase; color: var(--hx-copper-light); }
  /* Hero brand line: large and in its true spelling (capital X), so visitors see straight away what this is */
  .hero-brand { font-family: var(--font-display); font-weight: 700; font-size: clamp(1.75rem, 3.6vw, 2.75rem); line-height: 1.1; letter-spacing: -0.01em; color: var(--hx-copper-light); }
  .h2 { font-size: clamp(1.9rem, 3.8vw, 3rem); text-wrap: balance; max-width: 26ch; }
  .lead { margin-top: 1.25rem; font-size: clamp(1.075rem, 1.4vw, 1.2rem); line-height: 1.65; max-width: 62ch; }
  .head { max-width: 50rem; }
  /* Apps intro runs the full width of the page, like Why HX */
  .head.head-full, .head.head-full > p, .head.head-full .h2 { max-width: none; }
  .prose > p { margin-top: 1.15rem; font-size: 1.075rem; line-height: 1.7; max-width: 62ch; }
  .prose > .h2 + p { margin-top: 1.75rem; }

  /* Buttons: flat Copper with ivory text, Deep Bronze on hover. Text is 19px bold so it meets AA contrast as large text. */
  .actions { display: flex; flex-wrap: wrap; gap: .9rem; margin-top: 2.25rem; }
  .btn-hx { display: inline-flex; align-items: center; justify-content: center; min-height: 3.25rem; padding: .75rem 1.6rem; border: 2px solid var(--hx-copper); border-radius: var(--hx-radius); background: var(--hx-copper); color: var(--hx-ivory); font-size: 1.1875rem; font-weight: 700; letter-spacing: .04em; line-height: 1.25; text-align: center; text-decoration: none; transition: background-color .25s, border-color .25s, color .25s; }
  .btn-hx:hover { background: var(--hx-bronze); border-color: var(--hx-bronze); color: var(--hx-ivory); }
  .btn-hx-ghost { background: transparent; border-color: rgb(248 244 236 / .7); letter-spacing: 0; }
  .btn-hx-ghost:hover { background: rgb(248 244 236 / .1); border-color: var(--hx-ivory); }
  .mt-btn { margin-top: 2.25rem; }

  /* 1 | Hero: knot below the copy on phones, on the right from desktop */
  /* Phones: copy, both buttons, then the knot. Desktop: copy and knot side by side, with one button under each, on the same line. */
  .hero-grid { display: grid; grid-template-areas: "copy" "cta1" "cta2" "art"; row-gap: 1rem; padding-top: calc(var(--header-h) + clamp(2.5rem, 7vh, 4.5rem)); padding-bottom: clamp(3.5rem, 7vw, 6rem); }
  .hero-copy { grid-area: copy; }
  .hero-cta-1 { grid-area: cta1; margin-top: 1.25rem; }
  .hero-cta-2 { grid-area: cta2; display: flex; flex-wrap: wrap; gap: .9rem; }
  .hero-art { grid-area: art; margin-top: 1.5rem; }
  .hero-village { margin-top: 1.1rem; font-family: var(--font-display); font-weight: 700; font-size: clamp(1.3rem, 2vw, 1.6rem); line-height: 1.3; color: var(--hx-copper-light); }
  .hero-title { margin-top: 1.25rem; font-size: clamp(2.4rem, 5.6vw, 4.5rem); line-height: 1.08; max-width: 16ch; text-wrap: balance; }
  .hero-text { margin-top: 1.5rem; font-size: clamp(1.125rem, 1.6vw, 1.3rem); line-height: 1.6; max-width: 34rem; }
  .hero-italic { margin-top: 1.1rem; font-family: var(--font-sans); font-style: italic; font-size: clamp(1.1rem, 1.5vw, 1.25rem); line-height: 1.55; color: var(--hx-sand); max-width: 34rem; }
  .hero-art { width: min(100%, 26rem); justify-self: center; }
  .hero-art.hero-art-logo { width: min(100%, 25rem); }
  .hero-art :global(img) { display: block; width: 100%; height: auto; }
  /* The fallback knot artwork is on its own dark square, so its edges are softened into the section */
  .knot-blend :global(img) { -webkit-mask-image: radial-gradient(circle, #000 58%, transparent 71%); mask-image: radial-gradient(circle, #000 58%, transparent 71%); }
  @media (min-width: 64rem) {
    .hero-grid { grid-template-columns: 1.1fr .9fr; grid-template-areas: "copy art" "cta1 cta2"; column-gap: clamp(2rem, 5vw, 5rem); row-gap: 2.25rem; align-content: center; min-height: min(100svh, 52rem); }
    .hero-art { width: 100%; max-width: 34rem; justify-self: end; align-self: center; margin-top: 0; }
    .hero-art-logo { max-width: 25rem; justify-self: center; }
    .hero-cta-1 { margin-top: 0; align-self: start; }
    .hero-cta-2 { align-self: start; justify-self: center; }
  }

  /* 2 | Why HX */
  /* Why HX runs the full width of the page (as requested), heading and paragraphs alike */
  .why-solo .prose, .why-solo .prose > p, .why-solo .h2 { max-width: none; }
  .why-grid { display: grid; gap: clamp(2.5rem, 6vw, 5rem); align-items: center; }
  @media (min-width: 64rem) { .why-grid { grid-template-columns: 1.15fr .85fr; } }
  .why-art :global(img) { display: block; width: 100%; height: auto; }
  .prose > .why-closing { margin-top: 1.75rem; font-family: var(--font-display); font-weight: 700; font-size: clamp(1.3rem, 2vw, 1.6rem); line-height: 1.4; color: var(--hx-bronze); }
  .prose > .why-bold { margin-top: 1.5rem; font-size: 1.2rem; }
  .why-bold strong { font-weight: 700; }
  .prose > .why-signoff { margin-top: .75rem; font-size: clamp(1.15rem, 1.6vw, 1.35rem); line-height: 1.5; color: var(--hx-bronze); }

  /* 3 | App cards: 1 column on phones, 2 on tablets, 3 on desktop, 4 on wide screens. A short last row is centred. */
  .apps { --gap: 1.25rem; display: flex; flex-wrap: wrap; justify-content: center; gap: var(--gap); margin-top: clamp(2.5rem, 5vw, 3.5rem); }
  .app { flex: 0 0 100%; display: grid; align-content: start; gap: .6rem; padding: 1.75rem; border: 1px solid var(--hx-line); border-radius: var(--hx-radius); background: var(--hx-ivory); }
  /* Photo cards: 1 column on phones, 2 on tablets, 4 on desktop (two rows of 4).
     Symbol cards: smaller boxes, 2 on tablets, 3 on small laptops, all 5 on one row on desktop. */
  .apps-symbol { margin-top: var(--gap); }
  @media (min-width: 40rem) { .app { flex-basis: calc((100% - var(--gap)) / 2); } }
  @media (min-width: 56rem) { .apps-symbol .app { flex-basis: calc((100% - 2 * var(--gap)) / 3); } }
  @media (min-width: 64rem) {
    .apps-photo .app { flex-basis: calc((100% - 3 * var(--gap)) / 4); }
    .apps-symbol .app { flex-basis: calc((100% - 4 * var(--gap)) / 5); padding: 1.25rem; }
    .apps-symbol .app-name { font-size: 1.15rem; }
    .apps-symbol .app p { font-size: .95rem; }
    .apps-symbol .app :global(.app-icon) { width: 4rem; height: 4rem; }
  }
  .app :global(.app-icon) { display: block; width: 5rem; height: 5rem; object-fit: contain; margin-bottom: .5rem; }
