---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { site, social, links } from '@/data/site';
import ogImage from '@/assets/photos/duo-studio-b.jpg';
import logoImage from '@/assets/brand/ee-logo-full.png';
import { getImage } from 'astro:assets';

interface Offer { '@type': 'Offer'; name: string; price?: string; priceCurrency?: string; description?: string }
interface Props {
  title: string;
  description: string;
  /** Short page name for the breadcrumb trail given to search engines. Omit on the homepage. */
  breadcrumb?: string;
  /** Describes the page as a service, with its published prices, for search engines and AI assistants. */
  service?: { name: string; type: string; description: string; offers?: Offer[] };
  contactPage?: boolean;
  aboutPage?: boolean;
  noindex?: boolean;
  /** Article pages: published details for search engines, AI assistants and social sharing. */
  article?: { headline: string; image: string; imageAlt: string; datePublished: string; dateModified: string; author?: string; topics?: string[] };
}
const { title, description, breadcrumb, service, contactPage, aboutPage, noindex, article } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
const og = await getImage({ src: ogImage, width: 1200, height: 630, format: 'jpg' });
const logo = await getImage({ src: logoImage, width: 512, format: 'png' });
const abs = (p: string) => new URL(p, site.url).href;
const fullTitle = title.includes('Elevated eXperience') ? title : title + ' | Elevated eXperience';

// Structured data: one connected graph so search engines and AI assistants can tell who we are,
// what each page is and what we offer. Every fact here already appears in the approved page copy.
const orgId = site.url + '/#organization';
const siteId = site.url + '/#website';
const claire = {
  '@type': 'Person', '@id': site.url + '/#claire-boscq', name: 'Claire Boscq CSP', alternateName: 'The CX Energiser',
  jobTitle: 'Co-Founder, Elevated eXperience',
  description: 'Internationally recognised keynote speaker, author, Certified Speaking Professional and creator of BizShui™.',
  url: links.claire, worksFor: { '@id': orgId },
};
const andy = {
  '@type': 'Person', '@id': site.url + '/#andy-jarvis', name: 'Andy Jarvis', alternateName: 'The Digital King',
  jobTitle: 'Co-Founder, Elevated eXperience',
  description: 'International keynote speaker, author and Integrated Digital eXperience Architect.',
  url: links.andy, worksFor: { '@id': orgId },
};
const graph: Record<string, unknown>[] = [
  {
    '@type': 'Organization', '@id': orgId, name: site.name, legalName: site.legalName, url: site.url,
    slogan: 'From Friction to Flow',
    description: 'Elevated eXperience connects Digital, Employee and Customer eXperience through keynotes, Executive Masterclasses and Coachsulting, led by Claire Boscq CSP and Andy Jarvis, the Power Duo.',
    logo: { '@type': 'ImageObject', url: abs(logo.src) }, image: abs(og.src),
    email: site.email, telephone: site.phoneDisplay,
    address: { '@type': 'PostalAddress', streetAddress: 'Holly House, Tower Road', addressLocality: 'St Helier', addressRegion: 'Jersey', postalCode: 'JE2 3HR', addressCountry: 'JE' },
    contactPoint: { '@type': 'ContactPoint', contactType: 'enquiries', email: site.email, telephone: site.phoneDisplay, availableLanguage: ['English', 'French'] },
    founder: [{ '@id': claire['@id'] }, { '@id': andy['@id'] }],
    sameAs: social.map((s) => s.href),
    knowsAbout: ['Customer experience', 'Employee experience', 'Digital experience', 'Digital transformation', 'Keynote speaking', 'Leadership development', 'Corporate coaching'],
  },
  claire,
  andy,
  { '@type': 'WebSite', '@id': siteId, url: site.url, name: site.name, inLanguage: 'en-GB', publisher: { '@id': orgId } },
  {
    '@type': contactPage ? 'ContactPage' : aboutPage ? 'AboutPage' : 'WebPage', '@id': canonical + '#webpage', url: canonical, name: fullTitle, description,
    inLanguage: 'en-GB', isPartOf: { '@id': siteId }, about: { '@id': orgId }, primaryImageOfPage: article ? article.image : abs(og.src),
    ...(breadcrumb ? { breadcrumb: { '@id': canonical + '#breadcrumb' } } : {}),
  },
];
if (breadcrumb) {
  const trail = article
    ? [{ name: 'Home', item: abs('/') }, { name: 'Resources', item: abs(links.resources) }, { name: breadcrumb, item: canonical }]
    : [{ name: 'Home', item: abs('/') }, { name: breadcrumb, item: canonical }];
  graph.push({
    '@type': 'BreadcrumbList', '@id': canonical + '#breadcrumb',
    itemListElement: trail.map((t, i) => ({ '@type': 'ListItem', position: i + 1, ...t })),
  });
}
if (article) {
  const person = article.author && /claire/i.test(article.author) ? { '@id': claire['@id'] } : article.author && /andy/i.test(article.author) ? { '@id': andy['@id'] } : article.author ? { '@type': 'Person', name: article.author } : { '@id': orgId };
  graph.push({
    '@type': 'BlogPosting', '@id': canonical + '#article', headline: article.headline, description, url: canonical,
    mainEntityOfPage: { '@id': canonical + '#webpage' }, image: article.image, datePublished: article.datePublished, dateModified: article.dateModified,
    author: person, publisher: { '@id': orgId }, inLanguage: 'en-GB', isPartOf: { '@id': siteId },
    ...(article.topics?.length ? { keywords: article.topics.join(', '), articleSection: article.topics[0] } : {}),
  });
}
const shareImage = article ? article.image : abs(og.src);
const shareAlt = article ? article.imageAlt : 'Claire Boscq CSP and Andy Jarvis, the Power Duo behind Elevated eXperience';
if (service) {
  graph.push({
    '@type': 'Service', '@id': canonical + '#service', name: service.name, serviceType: service.type, description: service.description, url: canonical,
    provider: { '@id': orgId }, areaServed: 'Worldwide',
    ...(service.offers ? { offers: service.offers.map((o) => ({ ...o, url: canonical })) } : {}),
  });
}
const jsonLd = { '@context': 'https://schema.org', '@graph': graph };
const robots = noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Site summary for AI assistants" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="theme-color" content="#0b0c0f" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    {article && <meta property="article:published_time" content={article.datePublished} />}
    {article && <meta property="article:modified_time" content={article.dateModified} />}
    <meta property="og:locale" content="en_GB" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={shareAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <script>
      // Scroll reveals: content stays visible without JavaScript or with reduced motion.
      const els = document.querySelectorAll('.reveal, .reveal-img');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
        els.forEach((el) => io.observe(el));
      } else els.forEach((el) => el.classList.add('in'));

      // Background video: honour reduced motion and data saver, and only play while on screen.
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const saver = (navigator as any).connection?.saveData;
      document.querySelectorAll<HTMLVideoElement>('video[data-bg]').forEach((v) => {
        if (reduce || saver) { v.removeAttribute('autoplay'); v.pause(); return; }
        const vio = new IntersectionObserver(([e]) => {
          if (e.isIntersecting) { if (!v.dataset.userPaused) v.play().catch(() => {}); } else v.pause();
        }, { threshold: 0.1 });
        vio.observe(v);
      });

      // Number counters: the real figure is in the HTML; the animation is purely visual.
      if (!reduce) {
        const cio = new IntersectionObserver((entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            const el = e.target as HTMLElement; cio.unobserve(el);
            const end = Number(el.dataset.count); const t0 = performance.now(); const dur = 1400;
            const tick = (t: number) => {
              const p = Math.min(1, (t - t0) / dur); const eased = 1 - Math.pow(1 - p, 3);
              el.textContent = String(Math.round(end * eased));
              if (p < 1) requestAnimationFrame(tick);
            };
            requestAnimationFrame(tick);
          }
        }, { threshold: 0.6 });
        document.querySelectorAll('[data-count]').forEach((el) => cio.observe(el));
      }
    </script>
  </body>
</html>
