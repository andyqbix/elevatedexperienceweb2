---
// Article card for the Resources page. The whole card is clickable (stretched link on the title).
import Icon from '@/components/Icon.astro';
import { type Post, imageUrl, srcset, postUrl, formatDate, readingTime } from '@/lib/sanity';
interface Props { post: Post; size?: 'lg' | 'md'; headingLevel?: 'h3' | 'h4' }
const { post, size = 'md', headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
const ratio = size === 'lg' ? 16 / 10 : 16 / 9;
---
<article class:list={['acard', `acard-${size}`]} data-topics={(post.topics || []).join('|')}>
  <div class="a-media">
    <img src={imageUrl(post.mainImage, { w: 800, h: Math.round(800 / ratio) })} srcset={srcset(post.mainImage, [480, 800, 1200], ratio)} sizes={size === 'lg' ? '(min-width: 64rem) 50vw, 92vw' : '(min-width: 64rem) 30vw, (min-width: 40rem) 46vw, 92vw'} width="800" height={Math.round(800 / ratio)} alt={post.mainImage?.alt || ''} loading="lazy" decoding="async" />
  </div>
  <div class="a-body">
    {post.topics?.length ? <p class="a-topics">{post.topics.slice(0, 2).join(' · ')}</p> : null}
    <H class="a-title"><a href={postUrl(post.slug)}>{post.title}</a></H>
    <p class="a-excerpt">{post.excerpt}</p>
    <p class="a-meta">
      {post.author?.name && <span>{post.author.name}</span>}
      <time datetime={post.publishedAt}>{formatDate(post.publishedAt)}</time>
      <span>{readingTime(post.body)} min read</span>
    </p>
    <span class="a-more" aria-hidden="true">Read article <Icon name="arrow" /></span>
  </div>
</article>

<style>
  .acard { position: relative; display: flex; flex-direction: column; overflow: hidden; border-radius: 1.25rem; background: linear-gradient(180deg, rgb(255 255 255 / .05), rgb(255 255 255 / .015)); border: 1px solid rgb(255 255 255 / .1); transition: border-color .4s, transform .5s var(--ease-flow), box-shadow .5s var(--ease-flow); }
  .acard:hover, .acard:focus-within { border-color: rgb(203 108 82 / .6); transform: translateY(-4px); box-shadow: 0 30px 60px -30px rgb(0 0 0 / .8); }
  .a-media { aspect-ratio: 16 / 9; overflow: hidden; background: #17191d; }
  .acard-lg .a-media { aspect-ratio: 16 / 10; }
  .a-media img { width: 100%; height: 100%; object-fit: cover; transition: transform 1s var(--ease-flow); }
  .acard:hover .a-media img { transform: scale(1.04); }
  .a-body { display: flex; flex-direction: column; flex: 1; gap: .75rem; padding: clamp(1.3rem, 2.4vw, 1.9rem); }
  .a-topics { font-size: .68rem; font-weight: 700; letter-spacing: .2em; text-transform: uppercase; color: var(--color-copper-soft); }
  .a-title { font-family: var(--font-display); font-weight: 700; font-size: 1.3rem; line-height: 1.2; }
  .acard-lg .a-title { font-size: clamp(1.5rem, 2.4vw, 2rem); }
  .a-title a { color: #fff; text-decoration: none; }
  .a-title a::after { content: ""; position: absolute; inset: 0; border-radius: 1.25rem; }
  .a-title a:focus-visible { outline: none; }
  .a-title a:focus-visible::after { outline: 2px solid var(--color-gold); outline-offset: 3px; }
  .a-excerpt { color: rgb(255 255 255 / .74); font-size: .95rem; line-height: 1.6; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .acard-lg .a-excerpt { -webkit-line-clamp: 4; font-size: 1rem; }
  .a-meta { display: flex; flex-wrap: wrap; gap: .3rem .9rem; margin-top: auto; padding-top: .9rem; border-top: 1px solid rgb(255 255 255 / .1); font-size: .78rem; color: rgb(255 255 255 / .6); }
  .a-more { display: inline-flex; align-items: center; gap: .5rem; font-size: .72rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: var(--color-copper-soft); }
  .a-more :global(svg) { width: .9rem; height: .9rem; transition: transform .35s var(--ease-flow); }
  .acard:hover .a-more :global(svg) { transform: translateX(4px); }
</style>
