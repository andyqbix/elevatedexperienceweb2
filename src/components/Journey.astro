---
// Interactive connected journey (SHINE six stages, E.L.E.V.A.T.E. seven steps).
// Works as tabs with JavaScript; without it every stage is simply listed in full.
interface Step { label: string; name: string; question?: string; text: string }
interface Props { id: string; steps: Step[]; label: string; accent?: 'gold' | 'blue'; size?: 'lg' | 'sm' }
const { id, steps, label, accent = 'gold', size = 'lg' } = Astro.props;
---
<div class:list={['journey', `j-${accent}`, `j-${size}`]} data-journey style={`--n:${steps.length}`}>
  <div class="track" role="tablist" aria-label={label}>
    {steps.map((s, i) => (
      <button type="button" role="tab" id={`${id}-tab-${i}`} aria-controls={`${id}-panel-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} class="stop">
        <span class="n">{/^\d+$/.test(s.label) ? s.label.padStart(2, '0') : s.label}</span>
        <span class="name">{s.name}</span>
      </button>
    ))}
  </div>
  <div class="panels">
    {steps.map((s, i) => (
      <div role="tabpanel" id={`${id}-panel-${i}`} aria-labelledby={`${id}-tab-${i}`} class="panel" data-panel>
        <p class="p-label"><span>{/^\d+$/.test(s.label) ? s.label.padStart(2, '0') : s.label}</span>{s.name}</p>
        {s.question && <p class="p-q">{s.question}</p>}
        <p class="p-text">{s.text}</p>
      </div>
    ))}
  </div>
</div>

<style>
  .journey { --j: var(--color-gold); --j-grad: var(--grad-gold); --j-ink: #1c1608; }
  .j-blue { --j: var(--color-blue-sky); --j-grad: linear-gradient(100deg, #157ed9, #99ceea 50%, #4baddd); --j-ink: #04213f; }
  /* Stage strip: same look as the SHINE stages on the home page */
  .track { position: relative; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .75rem; }
  .stop { position: relative; display: grid; gap: .35rem; justify-items: start; text-align: left; padding: 1.1rem 1rem 1rem; border: 1px solid color-mix(in srgb, var(--j) 22%, transparent); border-radius: 1rem; background: linear-gradient(180deg, color-mix(in srgb, var(--j) 7%, transparent), transparent); color: #fff; cursor: pointer; transition: border-color .4s, transform .5s var(--ease-flow), background-color .4s; }
  .stop:hover { border-color: var(--j); transform: translateY(-4px); }
  .stop .n { font-size: .7rem; font-weight: 700; letter-spacing: .2em; color: var(--color-copper-soft); }
  .stop .name { font-family: var(--font-display); font-weight: 700; font-size: 1.15rem; letter-spacing: .06em; line-height: 1.15; overflow-wrap: anywhere; }
  .stop[aria-selected="true"] { background: var(--j-grad); border-color: transparent; color: var(--j-ink); }
  .stop[aria-selected="true"] .n { color: #52261d; }
  .j-blue .stop[aria-selected="true"] .n { color: #06305f; }
  .j-sm .track { grid-template-columns: repeat(auto-fill, minmax(7.25rem, 1fr)); gap: .5rem; }
  .j-sm .stop { padding: .8rem .85rem .75rem; border-radius: .8rem; }
  .j-sm .stop .name { font-size: .92rem; letter-spacing: .04em; }
  @media (min-width: 48rem) { .j-lg .track { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (min-width: 64rem) {
    .j-lg .track { grid-template-columns: repeat(var(--n), minmax(0, 1fr)); gap: 0; }
    .j-lg .stop { border-radius: 0; border-right-width: 0; padding: 1.5rem 1.25rem; }
    .j-lg .stop:first-child { border-radius: 1rem 0 0 1rem; }
    .j-lg .stop:last-child { border-radius: 0 1rem 1rem 0; border-right-width: 1px; }
    .j-lg .stop:not(:last-child)::after { content: ""; position: absolute; right: -.45rem; top: 50%; width: .8rem; height: .8rem; border-top: 1px solid var(--j); border-right: 1px solid var(--j); transform: translateY(-50%) rotate(45deg); background: var(--color-ink); z-index: 1; }
    .j-lg .stop:hover { transform: none; }
  }
  .panels { margin-top: 1.75rem; }
  .panel { padding: clamp(1.4rem, 3vw, 2.25rem); border-radius: 1.25rem; border: 1px solid color-mix(in srgb, var(--j) 28%, transparent); background: linear-gradient(160deg, color-mix(in srgb, var(--j) 10%, transparent), rgb(255 255 255 / .02)); }
  .panel + .panel { margin-top: .75rem; }
  .panel[hidden] { display: none; }
  .p-label { display: flex; align-items: center; gap: .75rem; font-size: .72rem; font-weight: 700; letter-spacing: .22em; color: var(--j); }
  .p-label span { font-family: var(--font-display); font-size: 1.1rem; letter-spacing: 0; }
  .p-q { margin-top: .8rem; font-family: var(--font-display); font-weight: 700; font-size: clamp(1.5rem, 3vw, 2.4rem); line-height: 1.08; }
  .p-text { margin-top: .8rem; color: rgb(255 255 255 / .82); max-width: 58ch; }
  .j-sm .p-q { font-size: clamp(1.3rem, 2vw, 1.6rem); }
  .j-sm .p-text { font-size: 1rem; }
  .j-sm .panel { padding: 1.4rem; }
  :global(.js) .panel.show { animation: j-in .5s var(--ease-flow) both; }
  @keyframes j-in { from { opacity: 0; transform: translateY(10px); } }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-journey]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];
    const select = (i: number, focus = false) => {
      tabs.forEach((t, k) => { t.setAttribute('aria-selected', String(k === i)); t.tabIndex = k === i ? 0 : -1; });
      panels.forEach((p, k) => { p.hidden = k !== i; p.classList.toggle('show', k === i); });
      if (focus) tabs[i].focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(i));
      t.addEventListener('keydown', (e) => {
        const n = tabs.length;
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') { e.preventDefault(); select((i + 1) % n, true); }
        else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') { e.preventDefault(); select((i + n - 1) % n, true); }
        else if (e.key === 'Home') { e.preventDefault(); select(0, true); }
        else if (e.key === 'End') { e.preventDefault(); select(n - 1, true); }
      });
    });
    select(0);
    panels[0].classList.remove('show');
  });
</script>
