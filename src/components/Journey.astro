---
// Interactive connected journey (SHINE six stages, E.L.E.V.A.T.E. seven steps).
// Works as tabs with JavaScript; without it every stage is simply listed in full.
interface Step { label: string; name: string; question?: string; text: string }
interface Props { id: string; steps: Step[]; label: string; accent?: 'gold' | 'blue'; size?: 'lg' | 'sm' }
const { id, steps, label, accent = 'gold', size = 'lg' } = Astro.props;
---
<div class:list={['journey', `j-${accent}`, `j-${size}`]} data-journey style={`--n:${steps.length};--cols:${Math.ceil(steps.length / 2)}`}>
  <div class="track" role="tablist" aria-label={label}>
    {steps.map((s, i) => (
      <button type="button" role="tab" id={`${id}-tab-${i}`} aria-controls={`${id}-panel-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} class="stop">
        <span class="n">{/^\d+$/.test(s.label) ? s.label.padStart(2, '0') : s.label}</span>
        <span class="name">{s.name}</span>
        <span class="cue" aria-hidden="true"></span>
      </button>
    ))}
  </div>
  <div class="panels" data-panels>
    {steps.map((s, i) => (
      <div role="tabpanel" id={`${id}-panel-${i}`} aria-labelledby={`${id}-tab-${i}`} class="panel" data-panel>
        <p class="p-label"><span>{/^\d+$/.test(s.label) ? s.label.padStart(2, '0') : s.label}</span>{s.name}</p>
        {s.question && <p class="p-q">{s.question}</p>}
        <p class="p-text">{s.text}</p>
      </div>
    ))}
  </div>
</div>

<style>
  .journey { --j: var(--color-gold); --j-grad: var(--grad-gold); --j-ink: #1c1608; }
  .j-blue { --j: var(--color-blue-sky); --j-grad: linear-gradient(100deg, #157ed9, #99ceea 50%, #4baddd); --j-ink: #04213f; }
  /* Stage strip: the home page look, used everywhere. Sizes itself to the space it sits in (container queries),
     so it is a joined bar when there is room and a grid of tiles when there is not. */
  .journey { container-type: inline-size; }
  .track { position: relative; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .75rem; }
  .stop { position: relative; display: grid; gap: .35rem; justify-items: start; align-content: center; text-align: left; padding: 1.1rem 1rem 1rem; border: 1px solid color-mix(in srgb, var(--j) 22%, transparent); border-radius: 1rem; background: linear-gradient(180deg, color-mix(in srgb, var(--j) 7%, transparent), transparent); color: #fff; cursor: pointer; transition: border-color .4s, background-color .4s, box-shadow .4s; }
  .stop:hover { border-color: var(--j); }
  .stop .n { font-size: .7rem; font-weight: 700; letter-spacing: .2em; color: var(--color-copper-soft); }
  .stop .name { font-family: var(--font-display); font-weight: 700; font-size: 1.15rem; letter-spacing: .06em; line-height: 1.15; overflow-wrap: anywhere; }
  /* The final SHINE stage is always gold, as on the home page */
  .j-gold .stop:last-child { background: var(--j-grad); border-color: transparent; color: var(--j-ink); }
  .j-gold .stop:last-child .n { color: #52261d; }
  /* Selected stage: lit from below with a bar in the accent colour */
  .stop[aria-selected="true"] { background-color: color-mix(in srgb, var(--j) 16%, transparent); border-color: var(--j); box-shadow: inset 0 -3px 0 var(--j), 0 0 0 1px var(--j), 0 12px 30px -14px color-mix(in srgb, var(--j) 70%, transparent); z-index: 2; }
  /* Click cue: a small + on every stage, which becomes a filled dot on the open one */
  .cue { position: absolute; right: .7rem; top: .7rem; width: 1.1rem; height: 1.1rem; border-radius: 50%; border: 1px solid color-mix(in srgb, var(--j) 55%, transparent); transition: background-color .3s, border-color .3s, transform .4s var(--ease-flow); }
  .cue::before, .cue::after { content: ""; position: absolute; left: 50%; top: 50%; width: .5rem; height: 1px; background: var(--j); transform: translate(-50%, -50%); transition: opacity .3s; }
  .cue::after { transform: translate(-50%, -50%) rotate(90deg); }
  .stop:hover .cue { transform: scale(1.12); border-color: var(--j); }
  .stop[aria-selected="true"] .cue { background: var(--j); border-color: var(--j); }
  .stop[aria-selected="true"] .cue::before, .stop[aria-selected="true"] .cue::after { opacity: 0; }
  .j-gold .stop:last-child .cue { border-color: rgb(28 22 8 / .45); }
  .j-gold .stop:last-child .cue::before, .j-gold .stop:last-child .cue::after { background: var(--j-ink); }
  .j-gold .stop:last-child[aria-selected="true"] .cue { background: var(--j-ink); border-color: var(--j-ink); }
  .stop[aria-selected="true"] .n { color: var(--j); }
  .j-gold .stop:last-child[aria-selected="true"] { box-shadow: inset 0 -3px 0 #6e4c0c, 0 0 0 2px var(--color-gold-pale), 0 12px 30px -14px color-mix(in srgb, var(--j) 70%, transparent); }
  .j-gold .stop:last-child[aria-selected="true"] .n { color: #52261d; }
  @container (min-width: 30rem) { .track { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @container (min-width: 38rem) { .track { grid-template-columns: repeat(var(--cols), minmax(0, 1fr)); } }
  @container (min-width: 44rem) {
    .track { grid-template-columns: repeat(var(--n), minmax(0, 1fr)); gap: 0; }
    .stop { border-radius: 0; border-inline-width: 0; padding: 1.4rem 1.1rem 1.3rem 1.4rem; }
    .stop:first-child { border-radius: 1rem 0 0 1rem; border-left-width: 1px; }
    .stop:last-child { border-radius: 0 1rem 1rem 0; border-right-width: 1px; }
    .stop:not(:last-child)::after { content: ""; position: absolute; right: -.4rem; top: 50%; width: .75rem; height: .75rem; border-top: 1px solid var(--j); border-right: 1px solid var(--j); transform: translateY(-50%) rotate(45deg); z-index: 1; pointer-events: none; }
    .stop .name { font-size: clamp(.85rem, 1.9cqi, 1.15rem); }
  }
  /* The open card is tied to its stage: a pointer slides under the selected stage, and the card carries a strong accent border */
  .panels { position: relative; margin-top: 1.4rem; --x: 50%; }
  :global(.js) .panels::before { content: ""; position: absolute; top: -.7rem; left: var(--x); width: 1.5rem; height: .75rem; transform: translateX(-50%); background: var(--j); clip-path: polygon(50% 0, 100% 100%, 0 100%); transition: left .45s var(--ease-flow), opacity .25s; z-index: 1; }
  .panels.no-pointer::before { opacity: 0; }
  .panel { position: relative; padding: clamp(1.4rem, 3vw, 2.25rem); border-radius: 1.25rem; border: 1.5px solid color-mix(in srgb, var(--j) 65%, transparent); border-top: 3px solid var(--j); background: linear-gradient(160deg, color-mix(in srgb, var(--j) 14%, transparent), rgb(255 255 255 / .02)); box-shadow: 0 24px 60px -30px color-mix(in srgb, var(--j) 45%, transparent); }
  .panel + .panel { margin-top: .75rem; }
  .panel[hidden] { display: none; }
  .p-label { display: flex; align-items: center; gap: .75rem; font-size: .72rem; font-weight: 700; letter-spacing: .22em; color: var(--j); }
  .p-label span { font-family: var(--font-display); font-size: 1.1rem; letter-spacing: 0; }
  .p-q { margin-top: .8rem; font-family: var(--font-display); font-weight: 700; font-size: clamp(1.5rem, 3vw, 2.4rem); line-height: 1.08; }
  .p-text { margin-top: .8rem; color: rgb(255 255 255 / .82); max-width: 58ch; }
  .j-sm .p-q { font-size: clamp(1.3rem, 2vw, 1.6rem); }
  .j-sm .p-text { font-size: 1rem; }
  .j-sm .panel { padding: 1.4rem; }
  :global(.js) .panel.show { animation: j-in .5s var(--ease-flow) both; }
  @keyframes j-in { from { opacity: 0; transform: translateY(10px); } }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-journey]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];
    // Slide the pointer above the card to sit under the selected stage
    const wrap = root.querySelector<HTMLElement>('[data-panels]')!;
    const place = () => {
      const t = tabs.find((x) => x.getAttribute('aria-selected') === 'true') ?? tabs[0];
      const a = t.getBoundingClientRect(), b = wrap.getBoundingClientRect();
      wrap.style.setProperty('--x', `${a.left + a.width / 2 - b.left}px`);
      // Only point when the selected stage sits in the row directly above the card
      const last = tabs[tabs.length - 1].getBoundingClientRect();
      wrap.classList.toggle('no-pointer', a.bottom < last.top);
    };
    window.addEventListener('resize', place);
    const select = (i: number, focus = false) => {
      tabs.forEach((t, k) => { t.setAttribute('aria-selected', String(k === i)); t.tabIndex = k === i ? 0 : -1; });
      panels.forEach((p, k) => { p.hidden = k !== i; p.classList.toggle('show', k === i); });
      if (focus) tabs[i].focus();
      place();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(i));
      t.addEventListener('keydown', (e) => {
        const n = tabs.length;
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') { e.preventDefault(); select((i + 1) % n, true); }
        else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') { e.preventDefault(); select((i + n - 1) % n, true); }
        else if (e.key === 'Home') { e.preventDefault(); select(0, true); }
        else if (e.key === 'End') { e.preventDefault(); select(n - 1, true); }
      });
    });
    select(0);
    panels[0].classList.remove('show');
  });
</script>
