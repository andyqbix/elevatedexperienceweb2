---
// Cinematic page hero: full-bleed photograph or silent looping video behind the approved headline.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from '@/components/Icon.astro';
interface Props {
  eyebrow: string;
  title: string;
  image?: ImageMetadata;
  alt?: string;
  position?: string;
  video?: { src: string; poster: string; mobileSrc?: string; sound?: boolean };
  size?: 'full' | 'compact';
  accent?: 'gold' | 'blue';
  /** On phones, show the whole photograph above the text instead of cropping it behind the text. */
  mobileFit?: boolean;
  /** Allow a longer headline to run wider before wrapping. */
  wideTitle?: boolean;
}
const { eyebrow, title, image, alt = '', position = '50% 30%', video, size = 'full', accent = 'gold', mobileFit = false, wideTitle = false } = Astro.props;
---
<section class:list={['page-hero', size, mobileFit && 'fit']} style={image ? '--ar:' + (image.width / image.height).toFixed(3) : undefined}>
  {video ? (
    <video class="media" data-bg data-hero-video autoplay muted loop playsinline preload="metadata" poster={video.poster} aria-hidden="true" tabindex="-1" style={`object-position:${position}`}>
      {video.mobileSrc && <source src={video.mobileSrc} type="video/mp4" media="(max-width: 700px)" />}
      <source src={video.src} type="video/mp4" />
    </video>
  ) : image ? (
    <Image class="media" src={image} alt={alt} widths={[640, 1024, 1600, 2400]} sizes="100vw" loading="eager" fetchpriority="high" style={`object-position:${position}`} />
  ) : null}
  <div class:list={['veil', video && 'veil-video']}></div>
  <div class="wrap inner">
    <p class:list={['eyebrow', accent === 'blue' && 'eyebrow-blue']}>{eyebrow}</p>
    <h1 class:list={['display-xl title', wideTitle && 'title-wide']}>{title}</h1>
    <div class="body"><slot /></div>
  </div>
  {video && (
    <button type="button" class:list={['pause', video.sound && 'with-sound']} data-pause aria-pressed="false">
      <Icon name="pause" class="i-pause" /><Icon name="play" class="i-play" />
      <span class="sr-only" data-pause-label>Pause video</span>
    </button>
  )}
  {video?.sound && (
    <button type="button" class="sound" data-sound aria-pressed="false">
      <Icon name="mute" class="i-off" /><Icon name="sound" class="i-on" />
      <span data-sound-label>Turn sound on</span>
    </button>
  )}
</section>

<style>
  .page-hero { position: relative; display: flex; align-items: flex-end; overflow: hidden; background: var(--color-ink); min-height: min(92svh, 58rem); }
  .page-hero.compact { min-height: min(70svh, 42rem); }
  .media { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; animation: settle 2.4s var(--ease-flow) both; }
  .veil { position: absolute; inset: 0; background:
    linear-gradient(180deg, rgb(11 12 15 / .7) 0%, rgb(11 12 15 / .15) 30%, rgb(11 12 15 / .55) 62%, var(--color-ink) 100%),
    linear-gradient(90deg, rgb(11 12 15 / .68) 0%, rgb(11 12 15 / .3) 40%, rgb(11 12 15 / 0) 72%); }
  .veil-video { background:
    linear-gradient(180deg, rgb(11 12 15 / .6) 0%, rgb(11 12 15 / .12) 30%, rgb(11 12 15 / .45) 68%, var(--color-ink) 100%),
    linear-gradient(90deg, rgb(11 12 15 / .72) 0%, rgb(11 12 15 / .4) 42%, rgb(11 12 15 / 0) 80%); }
  .inner { position: relative; padding-top: calc(var(--header-h) + 5rem); padding-bottom: clamp(3.5rem, 8vh, 6rem); }
  .eyebrow { animation: rise 1s var(--ease-flow) both .15s; }
  .title { max-width: 17ch; margin-top: 1.5rem; animation: rise 1.1s var(--ease-flow) both .3s; text-shadow: 0 2px 40px rgb(0 0 0 / .55); }
  .title-wide { max-width: 24ch; }
  .body { margin-top: 1.75rem; max-width: 44rem; animation: rise 1.1s var(--ease-flow) both .5s; }
  .body :global(.hero-line) { font-family: var(--font-display); font-weight: 600; font-size: clamp(1.3rem, 2.3vw, 1.9rem); line-height: 1.2; filter: drop-shadow(0 1px 10px rgb(0 0 0 / .7)); }
  .body :global(.hero-line + .hero-line) { margin-top: .5rem; }
  .body :global(.hero-line.gold) { background: var(--grad-gold); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .body :global(.hero-text) { margin-top: 1.25rem; color: rgb(255 255 255 / .92); max-width: 60ch; text-shadow: 0 1px 14px rgb(0 0 0 / .75); }
  .body :global(.hero-text strong) { color: #fff; }
  .body :global(.hero-cta) { margin-top: 2rem; display: flex; flex-wrap: wrap; gap: 1rem; }
  .sound { position: absolute; right: var(--gutter); bottom: 1.5rem; z-index: 2; display: inline-flex; align-items: center; gap: .6rem; min-height: 2.75rem; padding: .5rem 1.1rem; border-radius: 999px; font-size: .7rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: #fff; background: rgb(11 12 15 / .55); border: 1px solid rgb(255 255 255 / .3); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); cursor: pointer; transition: border-color .3s, background-color .3s; }
  .sound:hover { border-color: var(--color-gold); background: rgb(11 12 15 / .8); }
  .sound :global(svg) { width: 1.1rem; height: 1.1rem; }
  .sound :global(.i-on), .sound[aria-pressed="true"] :global(.i-off) { display: none; }
  .sound[aria-pressed="true"] :global(.i-on) { display: block; }
  .pause { position: absolute; right: var(--gutter); bottom: 1.5rem; z-index: 2; width: 2.75rem; height: 2.75rem; border-radius: 50%; display: grid; place-items: center; color: #fff; background: rgb(11 12 15 / .55); border: 1px solid rgb(255 255 255 / .3); cursor: pointer; opacity: .8; transition: opacity .3s, border-color .3s; }
  .pause.with-sound { bottom: 5rem; }
  .pause:hover, .pause:focus-visible { opacity: 1; border-color: var(--color-gold); }
  .pause :global(svg) { width: 1rem; height: 1rem; }
  .pause :global(.i-play), .pause[aria-pressed="true"] :global(.i-pause) { display: none; }
  .pause[aria-pressed="true"] :global(.i-play) { display: block; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  @keyframes rise { from { opacity: 0; transform: translateY(28px); } }
  @keyframes settle { from { transform: scale(1.08); } }
  /* Phones: keep the whole photograph visible, with the text beneath it */
  @media (max-width: 47.99rem) {
    .page-hero.fit { display: block; min-height: 0; padding-top: var(--header-h); }
    .fit .media { position: relative; inset: auto; height: auto; aspect-ratio: var(--ar, 1.6); max-height: 62svh; object-position: 50% 50% !important; -webkit-mask-image: linear-gradient(180deg, #000 72%, transparent); mask-image: linear-gradient(180deg, #000 72%, transparent); }
    .fit .veil { display: none; }
    .fit .inner { padding-top: 1.75rem; }
  }
  @media (max-width: 47.99rem) { .veil-video { background: linear-gradient(180deg, rgb(11 12 15 / .65) 0%, rgb(11 12 15 / .5) 45%, rgb(11 12 15 / .72) 75%, var(--color-ink) 100%); } }
  @media (max-width: 40rem) { .sound span { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); } .sound { padding: .5rem .8rem; } }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-pause]').forEach((btn) => {
    const video = btn.closest('section')!.querySelector<HTMLVideoElement>('[data-hero-video]')!;
    const label = btn.querySelector<HTMLElement>('[data-pause-label]')!;
    const sync = () => { btn.setAttribute('aria-pressed', String(video.paused)); label.textContent = video.paused ? 'Play video' : 'Pause video'; };
    btn.addEventListener('click', () => { if (video.paused) { delete video.dataset.userPaused; video.play().catch(() => {}); } else { video.dataset.userPaused = '1'; video.pause(); } });
    video.addEventListener('play', sync); video.addEventListener('pause', sync); sync();
  });
  document.querySelectorAll<HTMLButtonElement>('[data-sound]').forEach((btn) => {
    const video = btn.closest('section')!.querySelector<HTMLVideoElement>('[data-hero-video]')!;
    const label = btn.querySelector<HTMLElement>('[data-sound-label]')!;
    btn.addEventListener('click', () => {
      video.muted = !video.muted;
      if (!video.muted) { video.currentTime = 0; video.play().catch(() => {}); }
      btn.setAttribute('aria-pressed', String(!video.muted));
      label.textContent = video.muted ? 'Turn sound on' : 'Turn sound off';
    });
  });
</script>
