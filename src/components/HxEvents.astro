---
// Upcoming events from the HX | Hive eXperience feed.
// Cards are rendered when the site is built (so search engines and visitors without JavaScript see them),
// then refreshed in the browser from the same public feed, so new events appear and past ones drop off
// without a rebuild. Event text comes from Hive as written there; it is not part of the approved site copy.
import Icon from '@/components/Icon.astro';

const FEED = 'https://hive.elevatedexperience.vip/api/ee-events';

interface HiveEvent {
  id: string; title: string; description: string; event_date: string; event_time: string; end_date?: string; timezone: string;
  location: string; format: string; event_type: string; price: number; currency: string; image_url: string; event_url: string;
}

const strip = (html: string) => html
  .replace(/&nbsp;| /gi, ' ')
  .replace(/<\/(p|h[1-6]|li|blockquote)>|<br\s*\/?>/gi, ' ')
  .replace(/<[^>]+>/g, '')
  .replace(/&#(\d+);/g, (_, n) => String.fromCharCode(Number(n)))
  .replace(/&quot;/g, '"').replace(/&#39;|&apos;/g, "'").replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&amp;/g, '&')
  .replace(/\s*[—]\s*/g, ', ')
  .replace(/\s+/g, ' ').trim();
const excerpt = (html: string) => { const t = strip(html); return t.length <= 200 ? t : t.slice(0, t.lastIndexOf(' ', 200)) + '…'; };
const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const badge = (d: string) => { const [, m, day] = d.split('-').map(Number); return { day: String(day), month: MONTHS[m - 1] }; };
const virtual = (e: HiveEvent) => e.format?.toLowerCase() === 'virtual';
const where = (e: HiveEvent) => (virtual(e) ? 'Online' : (e.location || '').split(',')[0].trim() || 'Location to be confirmed');
const price = (e: HiveEvent) => {
  if (!e.price || e.price <= 0) return 'Free';
  try { return new Intl.NumberFormat('en-GB', { style: 'currency', currency: e.currency, minimumFractionDigits: e.price % 1 ? 2 : 0 }).format(e.price); } catch { return `${e.price} ${e.currency}`; }
};
const today = new Date().toISOString().slice(0, 10);

let events: HiveEvent[] = [];
try {
  const res = await fetch(FEED);
  if (res.ok) events = ((await res.json()).events as HiveEvent[]).filter((e) => (e.end_date || e.event_date) >= today);
} catch { /* feed unavailable at build: the browser will try again */ }
---
<div class="hx-events" data-hx-events data-feed={FEED}>
  <ul class="ev-grid" data-ev-grid>
    {events.map((e) => {
      const b = badge(e.event_date);
      return (
        <li class="ev" data-end={e.end_date || e.event_date}>
          <div class="ev-media">
            {e.image_url && <img src={e.image_url} alt="" loading="lazy" decoding="async" />}
            <span class="ev-date"><b>{b.day}</b><span>{b.month}</span></span>
            <span class="ev-format">{virtual(e) ? 'Online' : e.format}</span>
          </div>
          <div class="ev-body">
            <p class="ev-type">{e.event_type}</p>
            <h3 class="ev-title"><a href={e.event_url} target="_blank" rel="noopener noreferrer">{e.title}<span class="sr-only"> (opens on Hive eXperience in a new tab)</span></a></h3>
            <p class="ev-meta">{e.event_time} ({e.timezone}) · {where(e)}</p>
            <p class="ev-text">{excerpt(e.description)}</p>
            <div class="ev-foot"><span class="ev-price">{price(e)}</span><span class="ev-more">View details <Icon name="external" /></span></div>
          </div>
        </li>
      );
    })}
  </ul>
  <!-- /ev-grid -->
  <p class="ev-empty" data-ev-empty hidden={events.length > 0}>No upcoming events right now. Check back soon.</p>
</div>

<style>
  .ev-grid { display: grid; gap: 1.5rem; text-align: left; }
  .ev { position: relative; display: flex; flex-direction: column; overflow: hidden; border-radius: 1.25rem; border: 1px solid rgb(75 173 221 / .22); background: linear-gradient(160deg, rgb(21 126 217 / .1), rgb(255 255 255 / .02)); transition: border-color .4s, transform .5s var(--ease-flow); }
  .ev:hover, .ev:focus-within { border-color: var(--color-blue-sky); transform: translateY(-4px); }
  .ev-media { position: relative; aspect-ratio: 16 / 9; background: #071a33; overflow: hidden; }
  .ev-media img { width: 100%; height: 100%; object-fit: cover; transition: transform .6s var(--ease-flow); }
  .ev:hover .ev-media img { transform: scale(1.05); }
  .ev-date { position: absolute; left: .75rem; top: .75rem; display: grid; justify-items: center; padding: .4rem .7rem; border-radius: .6rem; background: rgb(11 12 15 / .85); line-height: 1; }
  .ev-date b { font-family: var(--font-display); font-size: 1.3rem; color: #fff; }
  .ev-date span { margin-top: .25rem; font-size: .62rem; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; color: var(--color-blue-sky); }
  .ev-format { position: absolute; right: .75rem; top: .75rem; padding: .3rem .75rem; border-radius: 999px; background: rgb(11 12 15 / .85); font-size: .62rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: var(--color-silver-light, #e2e3e6); }
  .ev-body { display: flex; flex-direction: column; flex: 1; padding: 1.4rem 1.4rem 1.25rem; }
  .ev-type { font-size: .68rem; font-weight: 700; letter-spacing: .2em; text-transform: uppercase; color: var(--color-blue-sky); }
  .ev-title { margin-top: .5rem; font-family: var(--font-display); font-weight: 700; font-size: 1.15rem; line-height: 1.25; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 2.5em; }
  .ev-title a { color: #fff; text-decoration: none; }
  .ev-title a::after { content: ""; position: absolute; inset: 0; border-radius: 1.25rem; }
  .ev-meta { margin-top: .5rem; font-size: .8rem; color: rgb(255 255 255 / .6); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ev-text { margin-top: .9rem; font-size: .92rem; line-height: 1.55; color: rgb(255 255 255 / .78); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; min-height: 4.65em; }
  .ev-foot { margin-top: auto; padding-top: 1rem; border-top: 1px solid rgb(255 255 255 / .1); display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .ev-text + .ev-foot { margin-top: 1.25rem; }
  .ev-price { font-weight: 700; color: var(--color-gold); }
  .ev-more { display: inline-flex; align-items: center; gap: .4rem; font-size: .7rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: rgb(255 255 255 / .75); }
  .ev:hover .ev-more { color: var(--color-blue-sky); }
  .ev-more :global(svg) { width: .8rem; height: .8rem; }
  .ev-empty { text-align: center; color: rgb(255 255 255 / .6); }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  @media (min-width: 40rem) { .ev-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 64rem) { .ev-grid { grid-template-columns: repeat(3, 1fr); } }
</style>

<script>
  // Refresh from the live feed in the browser. Built with DOM methods (textContent), never innerHTML,
  // because event text comes from an outside system.
  const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
  document.querySelectorAll<HTMLElement>('[data-hx-events]').forEach(async (root) => {
    const grid = root.querySelector<HTMLElement>('[data-ev-grid]')!;
    const empty = root.querySelector<HTMLElement>('[data-ev-empty]')!;
    const template = grid.querySelector<HTMLElement>('.ev');
    const today = new Date().toISOString().slice(0, 10);
    // Drop anything that has finished since the site was built
    grid.querySelectorAll<HTMLElement>('.ev').forEach((li) => { if ((li.dataset.end || '') < today) li.remove(); });
    empty.hidden = grid.children.length > 0;
    if (!template) return; // nothing to clone from; keep the built state
    try {
      const res = await fetch(root.dataset.feed!, { cache: 'no-cache' });
      if (!res.ok) return;
      const events = ((await res.json()).events as any[]).filter((e) => (e.end_date || e.event_date) >= today);
      const strip = (h: string) => { const d = new DOMParser().parseFromString(h.replace(/<\/(p|h[1-6]|li|blockquote)>|<br\s*\/?>/gi, ' '), 'text/html'); return (d.body.textContent || '').replace(/ /g, ' ').replace(/\s*—\s*/g, ', ').replace(/\s+/g, ' ').trim(); };
      const excerpt = (h: string) => { const t = strip(h); return t.length <= 200 ? t : t.slice(0, t.lastIndexOf(' ', 200)) + '…'; };
      const price = (e: any) => { if (!e.price || e.price <= 0) return 'Free'; try { return new Intl.NumberFormat('en-GB', { style: 'currency', currency: e.currency, minimumFractionDigits: e.price % 1 ? 2 : 0 }).format(e.price); } catch { return `${e.price} ${e.currency}`; } };
      const virtual = (e: any) => (e.format || '').toLowerCase() === 'virtual';
      const where = (e: any) => (virtual(e) ? 'Online' : (e.location || '').split(',')[0].trim() || 'Location to be confirmed');
      const cards = events.map((e) => {
        const li = template.cloneNode(true) as HTMLElement;
        const set = (sel: string, text: string) => { const el = li.querySelector(sel); if (el) el.textContent = text; };
        li.dataset.end = e.end_date || e.event_date;
        const [, m, day] = String(e.event_date).split('-').map(Number);
        li.querySelector('.ev-date b')!.textContent = String(day);
        li.querySelector('.ev-date span')!.textContent = MONTHS[m - 1];
        set('.ev-format', virtual(e) ? 'Online' : e.format);
        set('.ev-type', e.event_type);
        const a = li.querySelector<HTMLAnchorElement>('.ev-title a')!;
        a.firstChild!.textContent = e.title;
        if (/^https:\/\//.test(e.event_url)) a.href = e.event_url;
        set('.ev-meta', `${e.event_time} (${e.timezone}) · ${where(e)}`);
        set('.ev-text', excerpt(e.description || ''));
        set('.ev-price', price(e));
        const media = li.querySelector('.ev-media')!;
        let img = media.querySelector('img');
        if (e.image_url && /^https:\/\//.test(e.image_url)) {
          if (!img) { img = document.createElement('img'); img.alt = ''; img.loading = 'lazy'; media.prepend(img); }
          img.src = e.image_url;
        } else img?.remove();
        return li;
      });
      grid.replaceChildren(...cards);
      empty.hidden = cards.length > 0;
    } catch { /* keep what was built */ }
  });
</script>
