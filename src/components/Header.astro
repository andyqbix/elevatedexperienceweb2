---
import { Image } from 'astro:assets';
import flame from '@/assets/brand/ee-flame.png';
import wordmark from '@/assets/brand/ee-wordmark.png';
import Icon from '@/components/Icon.astro';
import { nav, links } from '@/data/site';
const path = Astro.url.pathname;
---
<header class="site-header" data-header>
  <div class="wrap bar">
    <a href="/" class="brand" aria-label="Elevated eXperience home">
      <Image src={flame} alt="" width={96} height={114} loading="eager" class="brand-mark" />
      <Image src={wordmark} alt="" height={88} loading="eager" class="brand-word" />
    </a>
    <nav class="primary" aria-label="Primary">
      <ul>
        {nav.map((n, i) => n.children ? (
          <li class="has-sub" data-sub>
            <a href={n.href} aria-current={path === n.href ? 'page' : undefined} class:list={[n.children.some((c) => c.href === path) && 'in-section']}>{n.label}</a>
            <button type="button" class="sub-btn" aria-expanded="false" aria-controls={`sub-${i}`} data-sub-btn><span class="sr-only">Show pages under {n.label}</span><Icon name="chevron" /></button>
            <ul class="sub" id={`sub-${i}`}>
              {n.children.map((c) => <li><a href={c.href} aria-current={path === c.href ? 'page' : undefined}>{c.label}</a></li>)}
            </ul>
          </li>
        ) : (
          <li><a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="actions">
      <a class="btn btn-primary cta" href={links.bookCall} target="_blank" rel="noopener noreferrer">Book a Call</a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-btn>
        <span class="sr-only">Menu</span>
        <Icon name="menu" class="i-open" /><Icon name="close" class="i-close" />
      </button>
    </div>
  </div>
  <div id="mobile-menu" class="mobile" data-menu hidden>
    <nav aria-label="Mobile">
      <ul>
        {nav.map((n, i) => (
          <li style={`--i:${i}`}>
            <a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a>
            {n.children && (
              <ul class="m-sub">
                {n.children.map((c) => <li><a href={c.href} aria-current={path === c.href ? 'page' : undefined}>{c.label}</a></li>)}
              </ul>
            )}
          </li>
        ))}
      </ul>
      <a class="btn btn-primary" href={links.bookCall} target="_blank" rel="noopener noreferrer">Book a Call</a>
    </nav>
  </div>
</header>

<style>
  .site-header { position: fixed; inset: 0 0 auto 0; z-index: 50; height: var(--header-h); transition: background-color .45s var(--ease-flow), box-shadow .45s; background: linear-gradient(180deg, rgb(11 12 15 / .72), rgb(11 12 15 / 0)); }
  /* The frosted bar is drawn on a separate layer: a blur on the header itself would trap the
     full-screen mobile menu inside the header's own height. */
  .site-header::before { content: ""; position: absolute; inset: 0; z-index: -1; opacity: 0; background: rgb(11 12 15 / .88); -webkit-backdrop-filter: blur(16px) saturate(130%); backdrop-filter: blur(16px) saturate(130%); box-shadow: 0 1px 0 rgb(203 108 82 / .2); transition: opacity .45s var(--ease-flow); pointer-events: none; }
  .site-header.scrolled::before, .site-header.open::before { opacity: 1; }
  .site-header.open::before { background: var(--color-ink); }
  .site-header.scrolled, .site-header.open { background: transparent; }
  .bar { height: 100%; display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; max-width: 96rem; }
  .brand { display: flex; align-items: center; gap: .7rem; flex: none; }
  .brand-word { height: 2.05rem; width: auto; }
  @media (max-width: 25.9rem) { .brand-word { height: 1.6rem; } }
  .brand-mark { height: 3.1rem; width: auto; transition: transform .6s var(--ease-flow); }
  .brand:hover .brand-mark { transform: scale(1.05); }
  .primary { display: none; }
  .primary ul { display: flex; align-items: center; gap: clamp(1rem, 1.6vw, 2rem); }
  .primary a { display: block; position: relative; font-size: .74rem; font-weight: 600; letter-spacing: .12em; color: rgb(255 255 255 / .82); text-decoration: none; padding-block: .6rem; white-space: nowrap; transition: color .3s; }
  .primary a::after { content: ""; position: absolute; left: 0; right: 0; bottom: .2rem; height: 1px; background: var(--grad-copper); transform: scaleX(0); transform-origin: left; transition: transform .45s var(--ease-flow); }
  .primary a:hover, .primary a[aria-current] { color: #fff; }
  .primary a:hover::after, .primary a[aria-current]::after, .primary a.in-section::after { transform: scaleX(1); }
  .primary a.in-section { color: #fff; }
  /* Dropdown under Power Duo: opens on hover, keyboard focus or the arrow button */
  .has-sub { position: relative; display: flex; align-items: center; gap: .2rem; }
  .sub-btn { margin-left: -.15rem; width: 1.6rem; height: 1.6rem; display: grid; place-items: center; color: rgb(255 255 255 / .7); cursor: pointer; border-radius: 50%; }
  .sub-btn :global(svg) { width: .8rem; height: .8rem; transition: transform .3s var(--ease-flow); }
  .sub-btn:hover { color: var(--color-copper-soft); }
  .sub { position: absolute; top: 100%; left: -1rem; min-width: 13rem; padding: .5rem; margin-top: .4rem; display: grid !important; gap: 0 !important; border-radius: .9rem; background: rgb(11 12 15 / .96); border: 1px solid rgb(203 108 82 / .3); box-shadow: 0 20px 40px -20px #000; opacity: 0; visibility: hidden; transform: translateY(-6px); transition: opacity .25s, transform .3s var(--ease-flow), visibility .25s; }
  .sub::before { content: ""; position: absolute; inset: -.8rem 0 auto 0; height: .8rem; }
  .sub a { display: block; padding: .7rem .9rem; border-radius: .6rem; }
  .sub a::after { display: none; }
  .sub a:hover, .sub a[aria-current] { background: rgb(203 108 82 / .14); color: var(--color-copper-soft); }
  .has-sub:hover .sub, .has-sub:focus-within .sub, .has-sub.open .sub { opacity: 1; visibility: visible; transform: none; }
  .has-sub:hover .sub-btn :global(svg), .has-sub.open .sub-btn :global(svg) { transform: rotate(180deg); }
  .m-sub { display: grid; padding: 0 0 .9rem 1.25rem; }
  .mobile li .m-sub li { border: 0; animation: none; }
  .mobile li .m-sub a { padding: .45rem 0; font-size: 1.15rem; font-weight: 500; color: rgb(255 255 255 / .75); }
  .actions { display: flex; align-items: center; gap: .75rem; }
  .cta { min-height: 2.6rem; padding: .55rem 1.25rem; font-size: .7rem; display: none; }
  .menu-btn { width: 2.9rem; height: 2.9rem; display: grid; place-items: center; border-radius: 50%; border: 1px solid rgb(255 255 255 / .25); color: #fff; cursor: pointer; }
  .menu-btn :global(svg) { width: 1.35rem; height: 1.35rem; grid-area: 1 / 1; transition: opacity .3s, transform .4s var(--ease-flow); }
  .menu-btn :global(.i-close) { opacity: 0; transform: rotate(-45deg); }
  .open .menu-btn :global(.i-open) { opacity: 0; transform: rotate(45deg); }
  .open .menu-btn :global(.i-close) { opacity: 1; transform: none; }
  .mobile { position: fixed; inset: var(--header-h) 0 0 0; height: calc(100dvh - var(--header-h)); background: var(--color-ink); overflow-y: auto; padding: 1.5rem var(--gutter) 3rem; }
  .mobile ul { display: grid; }
  .mobile li { border-bottom: 1px solid rgb(255 255 255 / .08); animation: slide .5s var(--ease-flow) both; animation-delay: calc(var(--i) * 40ms); }
  .mobile li a { display: block; padding: 1.05rem 0; font-family: var(--font-display); font-size: 1.6rem; font-weight: 600; color: #fff; text-decoration: none; }
  .mobile li a[aria-current] { color: var(--color-copper-soft); }
  .mobile .btn { margin-top: 2rem; width: 100%; }
  @keyframes slide { from { opacity: 0; transform: translateY(12px); } }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  @media (min-width: 26rem) { .cta { display: inline-flex; } }
  @media (min-width: 76rem) { .primary { display: block; } .menu-btn { display: none; } .mobile { display: none !important; } }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]')!;
  const menu = document.querySelector<HTMLElement>('[data-menu]')!;
  const onScroll = () => header.classList.toggle('scrolled', window.scrollY > 24);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
  const setOpen = (open: boolean) => {
    menu.hidden = !open;
    header.classList.toggle('open', open);
    btn.setAttribute('aria-expanded', String(open));
    document.documentElement.style.overflow = open ? 'hidden' : '';
  };
  btn.addEventListener('click', () => setOpen(menu.hidden));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.hidden) { setOpen(false); btn.focus(); } });
  document.querySelectorAll<HTMLElement>('[data-sub]').forEach((li) => {
    const b = li.querySelector<HTMLButtonElement>('[data-sub-btn]')!;
    const set = (open: boolean) => { li.classList.toggle('open', open); b.setAttribute('aria-expanded', String(open)); };
    b.addEventListener('click', () => set(!li.classList.contains('open')));
    li.addEventListener('focusout', (e) => { if (!li.contains(e.relatedTarget as Node)) set(false); });
    li.addEventListener('keydown', (e) => { if (e.key === 'Escape' && li.classList.contains('open')) { set(false); b.focus(); e.stopPropagation(); } });
  });
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  window.matchMedia('(min-width: 76rem)').addEventListener('change', (e) => e.matches && setOpen(false));
</script>
