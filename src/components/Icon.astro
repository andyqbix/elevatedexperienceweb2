---
<svg class={cls} viewBox="0 0 24 24" fill={isBrand ? 'currentColor' : 'none'} stroke={isBrand ? 'none' : 'currentColor'} stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden={label ? undefined : 'true'} role={label ? 'img' : undefined} aria-label={label}>
  <path d={isBrand ? brand[name] : line[name] ?? line.arrow} />
</svg>
